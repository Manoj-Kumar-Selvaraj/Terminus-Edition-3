#!/usr/bin/env python3
"""Sovereign RDS Control Plane API Server."""
import sys
import asyncio
from rds import app, database, migrations, config

async def main():
    cfg = config.load_config()
    
    # Run migrations
    await migrations.run_migrations(cfg.database_url)
    
    # Initialize database
    await database.init_database(cfg.database_url)
    
    # Start API server
    import uvicorn
    server = uvicorn.Server(uvicorn.Config(
        app.create_app(),
        host="0.0.0.0",
        port=8080,
        log_level="info"
    ))
    await server.serve()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        sys.exit(0)
