{
  "PolicyId": "alice-dev",
  "Version": "2012-10-17",
  "Description": "Personal branch namespace grant for dev-alice on the ledger repository.",
  "Statement": [
    {
      "Sid": "AliceOwnedBranches",
      "Effect": "Allow",
      "Action": [
        "codecommit:GitPush",
        "codecommit:GitPull"
      ],
      "Resource": "arn:aws:codecommit:eu-west-1:000000000000:ledger",
      "Condition": {
        "StringEquals": {
          "codecommit:References": [
            "refs/heads/dev/alice",
            "refs/heads/fix/alice"
          ]
        },
        "IpAddress": {
          "aws:SourceIp": ["10.8.0.0/16"]
        }
      }
    },
    {
      "Sid": "AliceOpensRequests",
      "Effect": "Allow",
      "Action": "codecommit:CreatePullRequest",
      "Resource": "arn:aws:codecommit:eu-west-1:000000000000:ledger"
    }
  ]
}
