{
  "rules": [
    {
      "rule_id": "ledger-mainline",
      "repo": "ledger",
      "dest": "refs/heads/main",
      "required": 2,
      "pool": ["rev-a", "rev-b", "rev-c"]
    },
    {
      "rule_id": "ledger-release-train",
      "repo": "ledger",
      "dest": "refs/heads/release",
      "required": 3,
      "pool": ["rev-a", "rev-b", "rev-c", "release-eng"]
    }
  ]
}
