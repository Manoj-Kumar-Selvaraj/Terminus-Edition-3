{
  "Statement": [
    {
      "Action": "codecommit:GitPull",
      "Effect": "Allow",
      "Resource": "arn:local:codecommit:local:000000000000:ledger",
      "Sid": "RevPull"
    },
    {
      "Action": "codecommit:MergePullRequestByFastForward",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "10.8.0.0/16"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:local:codecommit:local:000000000000:ledger",
      "Sid": "RevMerge"
    }
  ],
  "Version": "2012-10-17"
}
