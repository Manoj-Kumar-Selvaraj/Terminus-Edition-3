{
  "Statement": [
    {
      "Action": "codecommit:GitPull",
      "Effect": "Allow",
      "Resource": "arn:local:codecommit:local:000000000000:ledger",
      "Sid": "DevPull"
    },
    {
      "Action": "codecommit:GitPush",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "IpAddress": {
          "aws:SourceIp": "10.8.0.0/16"
        },
        "StringEquals": {
          "codecommit:References": "refs/heads/main"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:local:codecommit:local:000000000000:ledger",
      "Sid": "DevPushMain"
    },
    {
      "Action": "codecommit:GitPush",
      "Condition": {
        "StringEquals": {
          "codecommit:References": "refs/heads/release"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:local:codecommit:local:000000000000:ledger",
      "Sid": "ReleaseAllow"
    },
    {
      "Action": "codecommit:GitPush",
      "Condition": {
        "StringEquals": {
          "codecommit:References": "refs/heads/release"
        }
      },
      "Effect": "Deny",
      "Resource": "arn:local:codecommit:local:000000000000:ledger",
      "Sid": "ReleaseDeny"
    }
  ],
  "Version": "2012-10-17"
}
