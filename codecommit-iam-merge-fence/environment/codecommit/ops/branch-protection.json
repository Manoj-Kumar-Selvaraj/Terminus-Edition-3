{
  "rules": [
    {
      "allowed_merge_principals": [
        "rev-a",
        "rev-b"
      ],
      "pattern": "refs/heads/main",
      "repo": "ledger",
      "require_lease": true,
      "require_linear_history": true
    },
    {
      "allowed_merge_principals": [
        "rev-a",
        "rev-b"
      ],
      "pattern": "refs/heads/release",
      "repo": "ledger",
      "require_lease": true,
      "require_linear_history": true
    }
  ]
}
