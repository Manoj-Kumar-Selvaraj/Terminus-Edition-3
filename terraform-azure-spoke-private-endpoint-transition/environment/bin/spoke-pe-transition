#!/usr/bin/env python3
"""Plan the spoke workspace, run the network/DNS lab, write transition report."""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/app")
from spoke_lab import run_transition  # noqa: E402

WORKSPACE = Path("/app/terraform/workspaces/spoke")
VAR = Path("/app/var/spoke")
OUTPUT = Path("/app/output")


def run(cmd: list[str], cwd: Path) -> None:
    env = {
        **os.environ,
        "TF_CLI_CONFIG_FILE": "/app/terraform.tfrc",
        "TF_IN_AUTOMATION": "1",
        "CHECKPOINT_DISABLE": "1",
        "ARM_SUBSCRIPTION_ID": "00000000-0000-0000-0000-000000000000",
        "ARM_TENANT_ID": "00000000-0000-0000-0000-000000000000",
        "ARM_CLIENT_ID": "00000000-0000-0000-0000-000000000001",
        "ARM_CLIENT_SECRET": "not-used-by-mock",
    }
    proc = subprocess.run(cmd, cwd=str(cwd), env=env, text=True, capture_output=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        raise SystemExit(proc.returncode)


def main() -> int:
    VAR.mkdir(parents=True, exist_ok=True)
    OUTPUT.mkdir(parents=True, exist_ok=True)
    run(["terraform", "init", "-backend=false", "-input=false"], WORKSPACE)
    run(["terraform", "validate"], WORKSPACE)
    run(
        [
            "terraform",
            "plan",
            "-refresh=false",
            "-input=false",
            "-out=/app/var/spoke/tfplan",
        ],
        WORKSPACE,
    )
    show = subprocess.run(
        ["terraform", "show", "-json", "/app/var/spoke/tfplan"],
        cwd=str(WORKSPACE),
        env={
            **os.environ,
            "TF_CLI_CONFIG_FILE": "/app/terraform.tfrc",
            "TF_IN_AUTOMATION": "1",
        },
        text=True,
        capture_output=True,
        check=True,
    )
    plan = json.loads(show.stdout)
    report = run_transition(plan)
    print(json.dumps({"status": report["status"], "digest": report["report_digest"]}))
    return 0 if report["status"] == "READY" else 1


if __name__ == "__main__":
    raise SystemExit(main())
