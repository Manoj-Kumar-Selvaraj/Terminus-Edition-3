#!/usr/bin/env python3
"""Init/apply a Terraform workspace against the local HTTP backend."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

MIRROR = Path("/opt/terraform-provider-mirror")
LOCK_RE = re.compile(
    r'provider\s+"(?P<source>[^"]+)"\s*\{.*?hashes\s*=\s*\[(?P<hashes>.*?)\]',
    re.S,
)


def wait_healthy(base: str, timeout: float = 30.0) -> None:
    deadline = time.time() + timeout
    url = f"{base}/v1/control/health"
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=1) as resp:
                if resp.status == 200:
                    return
        except (urllib.error.URLError, TimeoutError):
            time.sleep(0.05)
    raise SystemExit(f"backend not healthy: {url}")


def verify_lockfile(lock_path: Path) -> None:
    if not lock_path.exists():
        raise SystemExit(f"missing lockfile: {lock_path}")
    text = lock_path.read_text(encoding="utf-8")
    unapproved = os.environ.get("UNAPPROVED_PROVIDER_DIR", "").strip()
    if unapproved:
        up = Path(unapproved)
        if up.exists() and any(p.is_file() for p in up.rglob("*")):
            raise SystemExit("unapproved provider package present; refusing apply")
    matches = list(LOCK_RE.finditer(text))
    if not matches:
        raise SystemExit("lockfile contains no provider hashes")
    for match in matches:
        source = match.group("source")
        # Lockfile sources are already registry.terraform.io/...
        provider_dir = MIRROR / source
        if not provider_dir.exists() or not any(provider_dir.rglob("*")):
            raise SystemExit(f"provider mirror missing source {source}")
        hashes = {
            h.strip().strip('"')
            for h in match.group("hashes").split(",")
            if h.strip().strip('"')
        }
        zh = {h for h in hashes if h.startswith("zh:")}
        mirrored = {
            f"zh:{hashlib.sha256(path.read_bytes()).hexdigest()}"
            for path in provider_dir.rglob("*.zip")
        }
        # Mirror layout stores unpacked provider binaries; presence of the source
        # tree plus any h1 hashes in the lockfile is the provenance gate.
        if not any(provider_dir.rglob("*")):
            raise SystemExit(f"empty provider mirror for {source}")
        if zh and mirrored and zh.isdisjoint(mirrored):
            raise SystemExit(f"provider lock hash not in mirror for {source}")
        if not hashes:
            raise SystemExit(f"provider lock missing hashes for {source}")


def run(cmd: list[str], cwd: Path, env: dict[str, str]) -> None:
    proc = subprocess.run(cmd, cwd=str(cwd), env=env, text=True, capture_output=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        raise SystemExit(proc.returncode)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workspace", required=True, choices=["prod", "stage"])
    parser.add_argument("--marker", default="")
    args = parser.parse_args()

    port = os.environ.get("BACKEND_PORT", "18765")
    host = os.environ.get("BACKEND_HOST", "127.0.0.1")
    base = f"http://{host}:{port}"
    wait_healthy(base)

    root = Path(f"/app/terraform/workspaces/{args.workspace}")
    env = {
        **os.environ,
        "TF_CLI_CONFIG_FILE": "/app/terraform.tfrc",
        "TF_IN_AUTOMATION": "1",
        "CHECKPOINT_DISABLE": "1",
        "BACKEND_BASE_URL": base,
    }
    if args.marker:
        env["TF_VAR_marker"] = args.marker

    run(["terraform", "init", "-input=false", "-reconfigure"], root, env)
    verify_lockfile(root / ".terraform.lock.hcl")
    run(["terraform", "apply", "-input=false", "-auto-approve"], root, env)

    state_url = f"{base}/v1/workspaces/{args.workspace}/state"
    with urllib.request.urlopen(state_url) as resp:
        remote = json.loads(resp.read().decode("utf-8"))
    print(
        json.dumps(
            {
                "workspace": args.workspace,
                "serial": remote.get("serial"),
                "lineage": remote.get("lineage"),
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
