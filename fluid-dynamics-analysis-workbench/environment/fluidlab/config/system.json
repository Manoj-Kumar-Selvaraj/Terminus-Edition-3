{
  "system_name": "fluidlab",
  "schema_version": "1.0",
  "output_dir": "/app/fluidlab/output",
  "publication": {
    "summary_name": "summary.json",
    "csv_name": "operating_points.csv",
    "checkpoint_name": "checkpoints/current.json",
    "severity_order": ["FAIL", "WARN", "PASS"],
    "round_digits": 6
  },
  "csv_fields": [
    "case_id",
    "point_id",
    "status",
    "flow_regime",
    "density_kg_m3",
    "velocity_m_s",
    "reynolds",
    "mach",
    "cfl",
    "pressure_drop_pa",
    "outlet_temperature_k",
    "heat_transfer_coefficient_w_m2k",
    "mesh_score",
    "converged",
    "finding_count"
  ]
}
