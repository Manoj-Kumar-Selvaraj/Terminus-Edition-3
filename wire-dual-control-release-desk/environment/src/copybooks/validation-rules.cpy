       VALIDATE-INITIATE-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-WIRE-ID
           PERFORM VALIDATE-DEBIT-ACCOUNT-ID
           PERFORM VALIDATE-CREDIT-ACCOUNT-ID
           PERFORM VALIDATE-AMOUNT-CENTS
           PERFORM VALIDATE-INITIATOR-ID.
       
       VALIDATE-APPROVE-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-WIRE-ID
           PERFORM VALIDATE-REVISION
           PERFORM VALIDATE-APPROVER-ID.
       
       VALIDATE-RELEASE-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-WIRE-ID
           PERFORM VALIDATE-REVISION.
       
       VALIDATE-CANCEL-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-WIRE-ID
           PERFORM VALIDATE-REVISION.
       
       VALIDATE-REQUEST-ID.
           MOVE H-REQUEST TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-REQUEST)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-REQUEST)) > 24
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-WIRE-ID.
           MOVE H-WIRE TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-WIRE)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-WIRE)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-DEBIT-ACCOUNT-ID.
           MOVE H-DEBIT-ACCOUNT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-DEBIT-ACCOUNT)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-DEBIT-ACCOUNT)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-CREDIT-ACCOUNT-ID.
           MOVE H-CREDIT-ACCOUNT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-CREDIT-ACCOUNT)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-CREDIT-ACCOUNT)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-INITIATOR-ID.
           MOVE H-INITIATOR TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-INITIATOR)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-INITIATOR)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-APPROVER-ID.
           MOVE H-APPROVER TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-APPROVER)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-APPROVER)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-GENERAL-ID.
           IF FUNCTION TRIM(WS-VALIDATION-CODE) = SPACES
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           PERFORM VARYING WS-INDEX FROM 1 BY 1
        UNTIL WS-INDEX > FUNCTION LENGTH(
              FUNCTION TRIM(WS-VALIDATION-CODE))
        MOVE WS-VALIDATION-CODE(WS-INDEX:1) TO WS-CHAR
        MOVE "N" TO WS-ALLOWED
        IF WS-CHAR >= "A" AND WS-CHAR <= "Z"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-CHAR >= "0" AND WS-CHAR <= "9"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-CHAR = "-"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-ALLOWED NOT = "Y"
            SET USAGE-INVALID TO TRUE
        END-IF
           END-PERFORM.
       
       VALIDATE-REVISION.
           MOVE WS-REVISION-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-REVISION-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-EXPECTED-REVISION =
        FUNCTION NUMVAL(FUNCTION TRIM(WS-REVISION-TEXT))
           IF H-EXPECTED-REVISION < 1 OR H-EXPECTED-REVISION > 999999
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-AMOUNT-CENTS.
           MOVE WS-AMOUNT-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-AMOUNT-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-AMOUNT =
        FUNCTION NUMVAL(FUNCTION TRIM(WS-AMOUNT-TEXT))
           IF H-AMOUNT < 1 OR H-AMOUNT > 999999999999
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-UNSIGNED-TEXT.
           IF FUNCTION TRIM(WS-VALIDATION-CODE) = SPACES
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           PERFORM VARYING WS-INDEX FROM 1 BY 1
        UNTIL WS-INDEX > FUNCTION LENGTH(
              FUNCTION TRIM(WS-VALIDATION-CODE))
        MOVE WS-VALIDATION-CODE(WS-INDEX:1) TO WS-CHAR
        IF WS-CHAR < "0" OR WS-CHAR > "9"
            SET USAGE-INVALID TO TRUE
        END-IF
           END-PERFORM.
