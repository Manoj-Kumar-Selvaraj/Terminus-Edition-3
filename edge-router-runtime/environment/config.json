{
  "listen": "127.0.0.1:18080",
  "admin_listen": "127.0.0.1:19090",
  "shutdown_timeout_ms": 2500,
  "upstream_timeout_ms": 1200,
  "routes": [
    {
      "host": "api.example.test",
      "path_prefix": "/v1/private",
      "upstreams": ["http://127.0.0.1:18082"]
    },
    {
      "host": "*.example.test",
      "path_prefix": "/v1",
      "upstreams": ["http://127.0.0.1:18081", "http://127.0.0.1:18082"]
    },
    {
      "host": "api.example.test",
      "path_prefix": "/",
      "upstreams": ["http://127.0.0.1:18081"]
    }
  ]
}
