#!/usr/bin/env python3
import json
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer

READY = "http://127.0.0.1:{{ fleet_promtail_port }}/ready"

def body():
    with urllib.request.urlopen(READY, timeout=2) as resp:
        ready = json.loads(resp.read().decode())
    token = ready["audit_token"]
    wire = f"token:{token}|metrics:{{ fleet_metrics_port }}|promtail:{{ fleet_promtail_port }}|audit:{{ fleet_audit_port }}"
    return json.dumps({
        "status": "ok",
        "component": "falco",
        "metrics_port": {{ fleet_metrics_port }},
        "audit_port": {{ fleet_audit_port }},
        "promtail_port": {{ fleet_promtail_port }},
        "wire": wire,
    }).encode()

class H(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.split("?")[0] != "/healthz":
            self.send_response(404)
            self.end_headers()
            return
        payload = body()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *args):
        pass

HTTPServer(("127.0.0.1", {{ fleet_falco_port }}), H).serve_forever()
