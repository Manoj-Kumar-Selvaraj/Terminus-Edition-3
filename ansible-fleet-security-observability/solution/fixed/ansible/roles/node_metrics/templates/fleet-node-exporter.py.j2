#!/usr/bin/env python3
import json
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

INV = Path("{{ fleet_root }}/var/lib/fleet-harden/inventory.json")

def body():
    doc = json.loads(INV.read_text(encoding="utf-8"))
    role = doc["role"]
    line = 'fleet_node_up{fleet_role="%s"} 1\n' % role
    return (
        "# HELP fleet_node_up Fleet edge up\n"
        "# TYPE fleet_node_up gauge\n"
        + line
    ).encode()

class H(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.split("?")[0] != "/metrics":
            self.send_response(404)
            self.end_headers()
            return
        payload = body()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *args):
        pass

HTTPServer(("127.0.0.1", {{ fleet_metrics_port }}), H).serve_forever()
