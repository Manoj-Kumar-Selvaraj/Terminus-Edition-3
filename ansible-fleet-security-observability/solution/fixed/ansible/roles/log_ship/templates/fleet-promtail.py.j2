#!/usr/bin/env python3
import json
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer

AUDIT = "http://127.0.0.1:{{ fleet_audit_port }}/healthz"

def body():
    with urllib.request.urlopen(AUDIT, timeout=2) as resp:
        audit = json.loads(resp.read().decode())
    return json.dumps({
        "status": "ok",
        "component": "promtail",
        "audit_port": {{ fleet_audit_port }},
        "metrics_port": {{ fleet_metrics_port }},
        "audit_token": audit["chain_token"],
    }).encode()

class H(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.split("?")[0] != "/ready":
            self.send_response(404)
            self.end_headers()
            return
        payload = body()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *args):
        pass

HTTPServer(("127.0.0.1", {{ fleet_promtail_port }}), H).serve_forever()
