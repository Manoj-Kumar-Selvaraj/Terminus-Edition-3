        "optional": {},
        "required": {
          "APPROVED_OPERATIONAL_REQUIREMENTS": [
            "Accept `ModifyDBInstance` only when status is `AVAILABLE`. Allocated storage must strictly increase; equal or smaller targets are rejected.",
            "Reject `DeleteDBInstance` when `DeletionProtection` is true, even if `FinalDBSnapshotIdentifier` is set.",
            "On reboot, reload config and apply pending static parameters; clear `PendingRebootParameters` only after boot-time validation succeeds.",
            "Ingest WAL archives with timeline/sequence continuity (flag gaps). For PITR, bind base backup LSN/timeline, partially replay WAL to the target time, and accept targets only when `EarliestRestorableTime <= target <= LatestRestorableTime`.",
            "Apply dynamic parameters immediately; mark static ones `pending-reboot`. Merge overrides into family defaults. `ResetDBParameterGroup` sets attached instances to `parameter_group_status=pending-reboot` and `PendingRebootParameters=true`.",
            "Before `PromoteReadReplica`, require `replication_lag_bytes <= MaximumAllowedLagBytes` (10485760) and LSN catch-up, revoke the old primary write lease, and atomically swap writer/reader endpoints (promotion does not perform floating-VIP ARP).",
            "Before Multi-AZ failover, acquire a leader lease with TTL fencing. Drive health from direct DB TCP reachability (ignore control-plane pool lag alone). On floating VIP migration, flush routes and send gratuitous ARP; record migration evidence per the failover contract.",
            "Enqueue EventBridge outbox rows in the same DB transaction as instance state changes. Match subscriptions by `SourceType` and event category. Use deterministic `EventIdentifier` hashes; write `event_delivery_audit` after max retries.",
            "Write durable transaction checkpoints for instance state transitions and, on restart, skip already-completed checkpointed operations.",
            "Enforce account, region, and `tenant_id` isolation on describe/list projections.",
            "Publish `/app/rds/out/rds-snapshot.json` (canonical sorted keys + `report_digest`), `/app/rds/out/instances.jsonl`, `/app/rds/out/events.jsonl`, and `/app/rds/out/health.json` with stable UTF-8 encoding and deterministic ordering."
          ],
          "APPROVED_WORK_PACKAGE": {
            "id": "WP1_SOVEREIGN_RDS_CONTROL_PLANE",
            "objective": "Complete a Go and Python sovereign RDS-compatible control plane that manages database instance lifecycles, WAL-backed point-in-time recovery (PITR), parameter group dynamic vs pending-reboot fencing, read replica stream promotion, multi-AZ failover fencing, and EventBridge-style event outbox notifications.",
            "persona": "A cloud platform engineer building an on-premise sovereign database control plane replacing AWS RDS.",
            "scope_exclusions": [
              "Terraform resource provisioning (stackyard-terraform-control-plane)",
              "Low-level storage engine MVCC or WAL format implementation (stonevault)",
              "L4 network load balancing / proxying (sovereign-l4-load-balancer)",
              "Backup vault policy enforcement (aws-backup-restore-assurance-plane)",
              "Logical CDC log capture or applying (tenant-catalog-logical-cdc-plane)",
              "Live AWS RDS API calls or external cloud access"
            ]
