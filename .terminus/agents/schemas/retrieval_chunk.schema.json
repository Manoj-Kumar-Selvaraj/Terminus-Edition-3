    {"if":{"properties":{"freshness_scope":{"contains":{"const":"REVIEW_SCOPE_HASH"}}}},"then":{"required":["review_scope_hash"]}},
    {"if":{"properties":{"freshness_scope":{"contains":{"const":"CI_RUN_ID"}}}},"then":{"required":["ci_run_id"]}},
    {"if":{"properties":{"source_kind":{"const":"CONTROL_PLANE_MARKDOWN"}}},"then":{"required":["source_path","git_blob_sha","control_plane_commit"],"properties":{"evidence_class":{"const":"CONTROL_PLANE_POLICY"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"CONTROL_PLANE_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"CONTROL_PLANE_JSON"}}},"then":{"required":["source_path","git_blob_sha","control_plane_commit"],"properties":{"evidence_class":{"const":"CONTROL_PLANE_POLICY"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"CONTROL_PLANE_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"CONTROL_PLANE_CODE"}}},"then":{"required":["source_path","git_blob_sha","control_plane_commit"],"properties":{"evidence_class":{"const":"CONTROL_PLANE_POLICY"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"CONTROL_PLANE_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"TASK_INSTRUCTION"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit"],"properties":{"evidence_class":{"const":"SOLVER_VISIBLE_TASK"},"sensitivity":{"const":"SOLVER_VISIBLE"},"solver_visible":{"const":true},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"TASK_DOCUMENTATION"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit"],"properties":{"evidence_class":{"const":"SOLVER_VISIBLE_TASK"},"sensitivity":{"const":"SOLVER_VISIBLE"},"solver_visible":{"const":true},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"TASK_CODE"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit"],"properties":{"evidence_class":{"const":"SOLVER_VISIBLE_TASK"},"sensitivity":{"const":"SOLVER_VISIBLE"},"solver_visible":{"const":true},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"TASK_CONFIGURATION"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit"],"properties":{"evidence_class":{"const":"SOLVER_VISIBLE_TASK"},"sensitivity":{"const":"SOLVER_VISIBLE"},"solver_visible":{"const":true},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"SOLVER_VISIBLE_REQUIREMENT_CONTRACT"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit","control_plane_commit"],"properties":{"evidence_class":{"const":"SOLVER_VISIBLE_TASK"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}},{"contains":{"const":"CONTROL_PLANE_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"enum":["PRIVATE_WORK_PACKAGE_DESIGN","PRIVATE_SYSTEM_ARCHITECTURE","PRIVATE_DEFECT_TOPOLOGY","PRIVATE_TEST_MAP"]}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit","control_plane_commit"],"properties":{"evidence_class":{"const":"PRIVATE_CREATION_DESIGN"},"sensitivity":{"const":"PRIVATE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}},{"contains":{"const":"CONTROL_PLANE_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"SOLUTION_ORACLE"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit"],"properties":{"evidence_class":{"const":"SOLUTION_ORACLE"},"sensitivity":{"const":"RESTRICTED"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"VERIFIER_PRIVATE"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit"],"properties":{"evidence_class":{"const":"VERIFIER_PRIVATE"},"sensitivity":{"const":"RESTRICTED"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"enum":["REVIEW_PACKET","REVIEW_RESULT"]}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit","control_plane_commit","role_contract_hash","packet_binding"],"properties":{"evidence_class":{"const":"CURRENT_REVIEW_PACKET"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}},{"contains":{"const":"CONTROL_PLANE_COMMIT"}},{"contains":{"const":"ROLE_CONTRACT_HASH"}},{"contains":{"const":"PACKET_BINDING"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"SESSION_STATE"}}},"then":{"required":["source_path","git_blob_sha","task_id","task_commit","control_plane_commit","policy_versions"],"properties":{"evidence_class":{"const":"DURABLE_SESSION_STATE"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"GIT_BLOB_SHA"}},{"contains":{"const":"TASK_COMMIT"}},{"contains":{"const":"CONTROL_PLANE_COMMIT"}},{"contains":{"const":"POLICY_VERSION"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"CI_RUNTIME"}}},"then":{"required":["task_id","task_commit","ci_run_id"],"properties":{"evidence_class":{"const":"CI_RUNTIME_EVIDENCE"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"CONTENT_HASH"}},{"contains":{"const":"TASK_COMMIT"}},{"contains":{"const":"CI_RUN_ID"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"MODEL_TRIAL"}}},"then":{"required":["task_id","task_commit"],"properties":{"evidence_class":{"const":"MODEL_TRIAL_EVIDENCE"},"sensitivity":{"const":"RESTRICTED"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"CONTENT_HASH"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"FINAL_PACKAGE"}}},"then":{"required":["task_id","task_commit"],"properties":{"evidence_class":{"const":"FINAL_PACKAGE_EVIDENCE"},"sensitivity":{"const":"CONTROL_PLANE"},"solver_visible":{"const":false},"freshness_scope":{"allOf":[{"contains":{"const":"CONTENT_HASH"}},{"contains":{"const":"TASK_COMMIT"}}]}}}},
    {"if":{"properties":{"source_kind":{"const":"PUBLIC_REFERENCE"}}},"then":{"properties":{"evidence_class":{"const":"PUBLIC_REFERENCE"},"sensitivity":{"const":"PUBLIC"},"solver_visible":{"const":false},"freshness_scope":{"contains":{"const":"EXTERNAL_CONTENT_HASH"}}}}}
  ]
}
