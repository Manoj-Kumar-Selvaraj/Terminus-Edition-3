{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminus-retrieval-chunk-v1",
  "title": "Terminus Retrieval Chunk Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata_contract_version","document_id","chunk_id","source_uri","source_kind","source_version","content_hash","evidence_class","sensitivity","solver_visible","stage_applicability","role_applicability","freshness_scope","chunk_type","structural_locator","ordinal"],
  "properties": {
    "metadata_contract_version":{"const":"1.0"},"document_id":{"type":"string","minLength":8},"chunk_id":{"type":"string","minLength":8},"source_uri":{"type":"string","minLength":1},"source_path":{"type":"string","minLength":1},
    "source_kind":{"type":"string","enum":["CONTROL_PLANE_MARKDOWN","CONTROL_PLANE_JSON","CONTROL_PLANE_CODE","TASK_INSTRUCTION","TASK_DOCUMENTATION","TASK_CODE","TASK_CONFIGURATION","SOLVER_VISIBLE_REQUIREMENT_CONTRACT","PRIVATE_WORK_PACKAGE_DESIGN","PRIVATE_SYSTEM_ARCHITECTURE","PRIVATE_DEFECT_TOPOLOGY","PRIVATE_TEST_MAP","SOLUTION_ORACLE","VERIFIER_PRIVATE","REVIEW_PACKET","REVIEW_RESULT","SESSION_STATE","CI_RUNTIME","MODEL_TRIAL","FINAL_PACKAGE","PUBLIC_REFERENCE"]},
