    "evidence_class":{"type":"string","enum":["CONTROL_PLANE_POLICY","SOLVER_VISIBLE_TASK","PRIVATE_CREATION_DESIGN","SOLUTION_ORACLE","VERIFIER_PRIVATE","CURRENT_REVIEW_PACKET","PRIOR_REVIEW_RESULTS","CI_RUNTIME_EVIDENCE","DURABLE_SESSION_STATE","PUBLIC_REFERENCE","MODEL_TRIAL_EVIDENCE","FINAL_PACKAGE_EVIDENCE"]},
    "sensitivity":{"type":"string","enum":["PUBLIC","SOLVER_VISIBLE","CONTROL_PLANE","PRIVATE","RESTRICTED"]},"solver_visible":{"type":"boolean"},"task_id":{"type":"string","minLength":1},"task_commit":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"control_plane_commit":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"policy_versions":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}},"role_contract_hash":{"type":"string","minLength":8},"packet_binding":{"type":"string","minLength":8},"review_scope_hash":{"type":"string","minLength":8},"ci_run_id":{"type":["integer","string"]},
    "stage_applicability":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["ALL_AUTHORIZED_STAGES","RULE_RESOLUTION","WORK_PACKAGE_RESEARCH","SYSTEM_ARCHITECTURE","DEFECT_TOPOLOGY","ENVIRONMENT_BUILD","REFERENCE_SOLUTION","VERIFIER_BUILD","HUMAN_WRITING_RESEARCH","INSTRUCTION_DRAFT","SPEC_ALIGNMENT","DOCUMENTATION_DRAFT","FORMAT_GATE","ASSEMBLY","COMPLEXITY_GATE","RUNTIME_AUTHENTICITY","DETERMINISTIC_VALIDATION","QUALITY_INTERLOCK","PRE_LLMAJ","MODEL_DIAGNOSTIC_GPT","MODEL_DIAGNOSTIC_CLAUDE","MODEL_DIAGNOSTIC_AGGREGATE","HARBOR_LLMAJ","OFFICIAL_MODEL_TRIALS","TRIAL_ANALYSIS","DIFFICULTY_ASSESSMENT","FINAL_REVIEW","SUBMISSION_READY"]}},
    "role_applicability":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["ALL_AUTHORIZED_ROLES","CREATION_CONTROLLER","CI_ORCHESTRATOR","A1_SCENARIO_RESEARCHER","A2_SYSTEM_ARCHITECT","A2_ENVIRONMENT_BUILDER","A3_DEFECT_TOPOLOGY_DESIGNER","A4_REFERENCE_SOLUTION_AUTHOR","A5_VERIFIER_AUTHOR","A6_HUMAN_WRITING_RESEARCHER","A7_INSTRUCTION_WRITER","A8_DOCUMENTATION_WRITER","A9_TASK_ASSEMBLY_AGENT","A10_COMPLEXITY_GOVERNOR","A11_AUTHORING_FAILURE_DIAGNOSTICIAN","Q1_SPEC_GAP_REPAIRER","Q2_VERIFIER_COVERAGE_REPAIRER","Q3_SPEC_AMBIGUITY_REPAIRER","Q4_SPEC_TEST_CONTRACT_REVIEWER","Q5_ORACLE_RUNTIME_REPAIR_SPECIALIST","Q6_PRODUCTION_LOGIC_AUDITOR","Q7_TASK_FORMAT_ENFORCER","Q8_MODEL_PERSPECTIVE_DIFFICULTY_SIMULATOR","TASK_ARCHITECT","ORIGINALITY_AUTHENTICITY_REVIEWER","VERIFIER_ENGINEER","HUMAN_QUALITY_REVIEWER","INSTRUCTION_REVIEWER","ENGINEERING_DOCUMENTATION_REVIEWER","COMPLIANCE_AUDITOR","COMPREHENSIVE_REVIEWER","ADJUDICATOR","DIFFICULTY_REVIEWER","TRAJECTORY_ANALYST","HARBOR_LLMAJ_GATE","OFFICIAL_MODEL_EVALUATION_GATE"]}},
    "freshness_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["CONTENT_HASH","GIT_BLOB_SHA","TASK_COMMIT","CONTROL_PLANE_COMMIT","POLICY_VERSION","ROLE_CONTRACT_HASH","PACKET_BINDING","REVIEW_SCOPE_HASH","CI_RUN_ID","EXTERNAL_CONTENT_HASH"]}},
    "chunk_type":{"type":"string","enum":["DOCUMENT","HEADING_SECTION","BULLET_GROUP","JSON_OBJECT","CODE_MODULE","CODE_CLASS","CODE_FUNCTION","CODE_SYMBOL","PACKET_SECTION","SESSION_SECTION","CI_STEP","LOG_EVENT_WINDOW","EXTERNAL_SECTION"]},"structural_locator":{"type":"string","minLength":1},"section_path":{"type":"array","items":{"type":"string"}},"symbol":{"type":"string","minLength":1},"line_start":{"type":"integer","minimum":1},"line_end":{"type":"integer","minimum":1},"ordinal":{"type":"integer","minimum":0},"indexed_at":{"type":"string","format":"date-time"}
  },
  "allOf": [
    {"if":{"properties":{"stage_applicability":{"contains":{"const":"ALL_AUTHORIZED_STAGES"}}}},"then":{"properties":{"stage_applicability":{"maxItems":1}}}},
    {"if":{"properties":{"role_applicability":{"contains":{"const":"ALL_AUTHORIZED_ROLES"}}}},"then":{"properties":{"role_applicability":{"maxItems":1}}}},
    {"if":{"properties":{"freshness_scope":{"contains":{"const":"GIT_BLOB_SHA"}}}},"then":{"required":["git_blob_sha"]}},
    {"if":{"properties":{"freshness_scope":{"contains":{"const":"TASK_COMMIT"}}}},"then":{"required":["task_commit"]}},
    {"if":{"properties":{"freshness_scope":{"contains":{"const":"CONTROL_PLANE_COMMIT"}}}},"then":{"required":["control_plane_commit"]}},
    {"if":{"properties":{"freshness_scope":{"contains":{"const":"POLICY_VERSION"}}}},"then":{"required":["policy_versions"]}},
    {"if":{"properties":{"freshness_scope":{"contains":{"const":"ROLE_CONTRACT_HASH"}}}},"then":{"required":["role_contract_hash"]}},
