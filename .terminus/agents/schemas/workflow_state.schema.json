{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminus-workflow-state-v1",
  "title": "Terminus Derived Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "state_snapshot_id", "task_id", "task_commit", "control_plane_commit",
    "ledger_head_event_id", "ledger_event_count", "nodes", "summary", "next", "derived_from"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "state_snapshot_id": {"type": "string", "pattern": "^state_[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "task_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "control_plane_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "ledger_head_event_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^evt_[0-9a-f]{64}$"}
      ]
    },
    "ledger_event_count": {"type": "integer", "minimum": 0},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "node_kind", "status", "reason"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "node_kind": {"enum": ["STAGE", "STATE"]},
          "status": {"enum": ["CURRENT", "STALE", "MISSING", "BLOCKED"]},
          "reason": {"type": "string", "minLength": 1},
          "record_id": {"type": "string", "pattern": "^rec_[0-9a-f]{64}$"},
          "invocation_id": {"type": "string", "pattern": "^inv_[0-9a-f]{64}$"},
          "ledger_event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{64}$"},
          "disposition": {"enum": ["ADVANCE", "ROUTE", "RETRY", "BLOCK"]},
          "route_key": {"type": "string", "minLength": 1},
          "blocking_reason": {"type": "string", "minLength": 1},
          "entry_requirements": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CURRENT", "STALE", "MISSING", "BLOCKED"],
      "properties": {
        "CURRENT": {"type": "integer", "minimum": 0},
        "STALE": {"type": "integer", "minimum": 0},
        "MISSING": {"type": "integer", "minimum": 0},
        "BLOCKED": {"type": "integer", "minimum": 0}
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {"enum": ["INVOKE_STAGE", "RETRY_STAGE", "ROUTE", "BLOCKED", "VALIDATE_STATE", "END"]},
        "stage_id": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "primary_role_id": {"type": "string", "minLength": 1},
        "required_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "optional_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "route_key": {"type": "string", "minLength": 1},
        "route_instruction": {"type": "string", "minLength": 1},
        "blocking_reason": {"type": "string", "minLength": 1}
      }
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_ids", "freshness_overlay_hash"],
      "properties": {
        "record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^rec_[0-9a-f]{64}$"}
        },
        "freshness_overlay_hash": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        }
      }
    }
  }
}
