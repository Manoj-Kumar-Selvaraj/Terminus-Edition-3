{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminus-executor-handoff-v1",
  "title": "Terminus Executor Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "executor_mode",
    "invocation_id",
    "stage",
    "authority",
    "do",
    "do_not",
    "result_contract",
    "invocation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "pattern": "^handoff_[0-9a-f]{64}$"},
    "executor_mode": {"enum": ["MANUAL_CHAT", "LOCAL_COMMAND"]},
    "invocation_id": {"type": "string", "pattern": "^inv_[0-9a-f]{64}$"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "role_id", "owner", "role_class"],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "role_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "role_class": {"type": "string", "minLength": 1}
      }
    },
    "authority": {"type": "object", "minProperties": 1},
    "do": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "do_not": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "result_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "invocation_id",
        "required_top_level_fields",
        "optional_top_level_fields",
        "allowed_status_values",
        "required_output_fields",
        "optional_output_fields"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "invocation_id": {"type": "string", "pattern": "^inv_[0-9a-f]{64}$"},
        "required_top_level_fields": {"type": "array", "items": {"type": "string"}},
        "optional_top_level_fields": {"type": "array", "items": {"type": "string"}},
        "allowed_status_values": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_output_fields": {"type": "array", "items": {"type": "string"}},
        "optional_output_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "invocation": {"type": "object", "minProperties": 1},
    "handoff_text": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"executor_mode": {"const": "MANUAL_CHAT"}}},
      "then": {"required": ["handoff_text"]}
    },
    {
      "if": {"properties": {"executor_mode": {"const": "LOCAL_COMMAND"}}},
      "then": {"not": {"required": ["handoff_text"]}}
    }
  ]
}
