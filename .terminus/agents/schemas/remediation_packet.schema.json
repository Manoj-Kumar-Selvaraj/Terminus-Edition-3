{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminus-remediation-packet-v1",
  "title": "Terminus Remediation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "remediation_id", "finding_id", "task_id", "input_task_commit", "steps", "closure_owner", "prohibited_shortcuts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "remediation_id": {"type": "string", "pattern": "^remediation_[0-9a-f]{64}$"},
    "finding_id": {"type": "string", "pattern": "^finding_[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "input_task_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "stage_id", "role_id", "responsibility", "required_behavior", "closure_conditions"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "stage_id": {"type": "string", "minLength": 1},
          "role_id": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "required_behavior": {"type": "string", "minLength": 1},
          "closure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "closure_owner": {"type": "string", "minLength": 1},
    "prohibited_shortcuts": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
