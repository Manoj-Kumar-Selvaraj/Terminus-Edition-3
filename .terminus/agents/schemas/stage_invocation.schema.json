{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminus-stage-invocation-v1",
  "title": "Terminus Stage Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "invocation_id", "readiness", "stage", "authority", "inputs",
    "missing_required_inputs", "ignored_input_count", "evidence", "retrieval", "learning",
    "output_contract", "acceptance_predicates", "routing"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "invocation_id": {"type": "string", "pattern": "^inv_[0-9a-f]{64}$"},
    "readiness": {"enum": ["READY", "BLOCKED_MISSING_INPUTS"]},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "role_id", "owner", "role_class", "lifecycle"],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "role_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "role_class": {"type": "string", "minLength": 1},
        "lifecycle": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_plane_commit", "policy_versions"],
      "dependentRequired": {"task_id": ["task_commit"], "task_commit": ["task_id"]},
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "control_plane_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "role_contract_hash": {"type": "string", "minLength": 8},
        "packet_binding": {"type": "string", "minLength": 8},
        "review_scope_hash": {"type": "string", "minLength": 8},
        "ci_run_id": {"type": ["string", "integer"]},
        "policy_versions": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {"required": {"type": "object"}, "optional": {"type": "object"}}
    },
    "missing_required_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ignored_input_count": {"type": "integer", "minimum": 0},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_mode", "mandatory_exact_reads", "authorized_evidence_classes", "excluded_evidence_classes", "evidence_required"],
      "properties": {
        "retrieval_mode": {"enum": ["EXACT_ONLY", "FILTERED_HYBRID", "SOLVER_VISIBLE_ONLY", "EXTERNAL_BOUND"]},
        "mandatory_exact_reads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authorized_evidence_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded_evidence_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_required": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "query", "retrieved_context", "retrieved_chars"],
      "properties": {
        "status": {"enum": ["INDEXED_CONTEXT", "DIRECT_READ_FALLBACK", "NOT_REQUESTED", "SKIPPED_BLOCKED_INPUTS"]},
        "query": {"type": ["string", "null"]},
        "retrieved_context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chunk_id", "source_kind", "evidence_class", "structural_locator", "content_hash", "content", "score"],
            "properties": {
              "chunk_id": {"type": "string", "minLength": 1},
              "source_path": {"type": ["string", "null"]},
              "source_kind": {"type": "string", "minLength": 1},
              "evidence_class": {"type": "string", "minLength": 1},
              "structural_locator": {"type": ["string", "null"]},
              "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "content": {"type": "string"},
              "score": {"type": "number"},
              "truncated": {"type": "boolean"}
            }
          }
        },
        "retrieved_chars": {"type": "integer", "minimum": 0}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "registry_heads", "lessons", "remediations", "raw_feedback_exposed", "raw_historical_findings_exposed", "context_hash"],
      "properties": {
        "mode": {"const": "GENERALIZED_LESSONS_PLUS_OWNED_REMEDIATIONS"},
        "registry_heads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["feedback", "findings", "lessons", "patterns", "remediations"],
          "properties": {
            "feedback": {"type": "string", "pattern": "^(GENESIS|sha256:[0-9a-f]{64})$"},
            "findings": {"type": "string", "pattern": "^(GENESIS|sha256:[0-9a-f]{64})$"},
            "lessons": {"type": "string", "pattern": "^(GENESIS|sha256:[0-9a-f]{64})$"},
            "patterns": {"type": "string", "pattern": "^(GENESIS|sha256:[0-9a-f]{64})$"},
            "remediations": {"type": "string", "pattern": "^(GENESIS|sha256:[0-9a-f]{64})$"}
          }
        },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lesson_id", "category", "failure_pattern", "future_rule"],
            "properties": {
              "lesson_id": {"type": "string", "pattern": "^lesson_[0-9a-f]{64}$"},
              "category": {"type": "string", "minLength": 1},
              "failure_pattern": {"type": "string", "minLength": 1},
              "future_rule": {"type": "string", "minLength": 1}
            }
          }
        },
        "remediations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["remediation_id", "finding_id", "responsibility", "required_behavior", "closure_conditions", "prohibited_shortcuts"],
            "properties": {
              "remediation_id": {"type": "string", "pattern": "^remediation_[0-9a-f]{64}$"},
              "finding_id": {"type": "string", "pattern": "^finding_[0-9a-f]{64}$"},
              "responsibility": {"type": "string", "minLength": 1},
              "required_behavior": {"type": "string", "minLength": 1},
              "closure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "prohibited_shortcuts": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "raw_feedback_exposed": {"const": false},
        "raw_historical_findings_exposed": {"const": false},
        "context_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_status_values", "required_fields", "optional_fields", "persisted_artifacts", "deterministic_validators", "semantic_reviewers"],
      "properties": {
        "allowed_status_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "optional_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "persisted_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deterministic_validators": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "semantic_reviewers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "acceptance_predicates": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/predicate"}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_routes", "success_transition", "stale_on"],
      "properties": {
        "failure_routes": {"type": "object", "additionalProperties": {"type": "string"}},
        "success_transition": {"type": "string", "minLength": 1},
        "stale_on": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "op"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "op": {"enum": ["eq", "in", "empty", "nonempty", "length_eq", "lt", "lte", "gt", "gte", "all_gte", "eq_path", "q4_satisfied"]},
        "value": {}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"readiness": {"const": "READY"}}},
      "then": {"properties": {"missing_required_inputs": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"readiness": {"const": "BLOCKED_MISSING_INPUTS"}}},
      "then": {"properties": {"missing_required_inputs": {"minItems": 1}}}
    }
  ]
}