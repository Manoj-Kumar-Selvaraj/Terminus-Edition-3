{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminus-review-result-v3",
  "title": "Terminus Specialist Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "review_id",
    "task",
    "task_commit",
    "control_plane_commit",
    "protocol_policy_version",
    "prompt_policy_version",
    "role_policy_version",
    "role_contract_hash",
    "context_packet",
    "verdict",
    "confidence",
    "evidence_status",
    "summary",
    "evidence",
    "findings",
    "missing_evidence",
    "change_scope",
    "do_not_change",
    "next_gate",
    "role_output"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "role": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "task_commit": {"type": "string", "minLength": 7},
    "control_plane_commit": {"type": "string", "minLength": 7},
    "protocol_policy_version": {"type": "string", "minLength": 1},
    "prompt_policy_version": {"type": "string", "minLength": 1},
    "role_policy_version": {"type": "string", "minLength": 1},
    "role_contract_hash": {"type": "string", "minLength": 16},
    "review_scope_hash": {"type": "string", "minLength": 16},
    "context_packet": {"type": "string", "minLength": 1},
    "verdict": {
      "enum": [
        "PASS",
        "REVISE",
        "REJECT",
        "INSUFFICIENT_EVIDENCE",
        "APPROVE",
        "APPROVE_WITH_NOTE",
        "REQUEST_CHANGES",
        "DECLINE",
        "POLICY_CONFLICT"
      ]
    },
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "evidence_status": {"enum": ["SUFFICIENT", "INSUFFICIENT"]},
    "summary": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref", "observation"],
        "properties": {
          "type": {
            "enum": [
              "file",
              "rule",
              "test",
              "run",
              "job",
              "artifact",
              "trajectory",
              "public_reference",
              "review",
              "ci"
            ]
          },
          "ref": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "status",
          "criterion",
          "evidence_refs",
          "why_it_matters",
          "minimal_remediation",
          "regression_risk"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]},
          "status": {"enum": ["OBSERVED", "INFERRED"]},
          "criterion": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "why_it_matters": {"type": "string", "minLength": 1},
          "minimal_remediation": {"type": "string"},
          "regression_risk": {"type": "string"}
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "change_scope": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "do_not_change": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_gate": {"type": "string"},
    "role_output": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "INSUFFICIENT_EVIDENCE"}}},
      "then": {
        "properties": {
          "evidence_status": {"const": "INSUFFICIENT"},
          "missing_evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "Production Logic Auditor"}}},
      "then": {
        "required": ["review_scope_hash"]
      }
    },
    {
      "if": {"properties": {"role": {"const": "Spec-Test Contract Reviewer"}}},
      "then": {
        "properties": {
          "role_output": {
            "type": "object",
            "required": [
              "REQUIREMENT_TEST_MATRIX",
              "PHANTOM_TEST_CONTRACTS",
              "UNTESTED_REQUIREMENTS",
              "AMBIGUITIES",
              "DELEGATED_CONTRACT_CHECK",
              "SPEC_DUMP_RISK",
              "BIDIRECTIONAL_ALIGNMENT",
              "BLOCKING_FINDING_IDS",
              "ADVISORY_FINDING_IDS",
              "EXHAUSTIVENESS"
            ],
            "properties": {
              "BLOCKING_FINDING_IDS": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "ADVISORY_FINDING_IDS": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "EXHAUSTIVENESS": {
                "type": "object",
                "required": [
                  "REQUIREMENTS_ENUMERATED",
                  "VERIFIER_BEHAVIORS_ENUMERATED",
                  "FORWARD_MATRIX_COMPLETE",
                  "REVERSE_MATRIX_COMPLETE",
                  "DELEGATED_CONTRACTS_COMPLETE",
                  "P2P_BOUNDARIES_COMPLETE",
                  "F2P_BOUNDARIES_COMPLETE",
                  "OUTPUT_INTERFACES_COMPLETE",
                  "SECOND_PASS_OMISSION_SWEEP",
                  "UNINSPECTED_SCOPE"
                ],
                "properties": {
                  "REQUIREMENTS_ENUMERATED": {"enum": ["COMPLETE", "INCOMPLETE"]},
                  "VERIFIER_BEHAVIORS_ENUMERATED": {"enum": ["COMPLETE", "INCOMPLETE"]},
                  "FORWARD_MATRIX_COMPLETE": {"enum": ["YES", "NO"]},
                  "REVERSE_MATRIX_COMPLETE": {"enum": ["YES", "NO"]},
                  "DELEGATED_CONTRACTS_COMPLETE": {"enum": ["YES", "NO"]},
                  "P2P_BOUNDARIES_COMPLETE": {"enum": ["YES", "NO"]},
                  "F2P_BOUNDARIES_COMPLETE": {"enum": ["YES", "NO"]},
                  "OUTPUT_INTERFACES_COMPLETE": {"enum": ["YES", "NO"]},
                  "SECOND_PASS_OMISSION_SWEEP": {"enum": ["PASS", "INCOMPLETE"]},
                  "UNINSPECTED_SCOPE": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
