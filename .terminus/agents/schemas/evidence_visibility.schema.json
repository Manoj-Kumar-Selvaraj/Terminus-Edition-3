{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminus-evidence-visibility-v1",
  "title": "Terminus Stage Evidence Visibility Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["visibility_version", "evidence_classes", "stages"],
  "properties": {
    "visibility_version": {"type": "string", "const": "1.1"},
    "evidence_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/evidenceClass"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stageVisibility"}
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidenceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "default_sensitivity"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "default_sensitivity": {
          "type": "string",
          "enum": ["PUBLIC", "SOLVER_VISIBLE", "CONTROL_PLANE", "PRIVATE", "RESTRICTED"]
        }
      }
    },
    "stageVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "required_evidence_classes",
        "allowed_optional_evidence_classes",
        "excluded_evidence_classes",
        "retrieval_mode",
        "output_disposition"
      ],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "required_evidence_classes": {"$ref": "#/$defs/stringArray"},
        "allowed_optional_evidence_classes": {"$ref": "#/$defs/stringArray"},
        "excluded_evidence_classes": {"$ref": "#/$defs/stringArray"},
        "retrieval_mode": {
          "type": "string",
          "enum": ["EXACT_ONLY", "FILTERED_HYBRID", "SOLVER_VISIBLE_ONLY", "EXTERNAL_BOUND"]
        },
        "output_disposition": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["EPHEMERAL", "DURABLE_CONTROL_PLANE", "PRIVATE_CONTROL_PLANE", "TASK_ARTIFACT", "REVIEW_EVIDENCE", "EXTERNAL_EVIDENCE"]
          }
        }
      }
    }
  }
}
