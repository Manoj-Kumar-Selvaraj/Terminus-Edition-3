{
  "policy_version": "1.0",
  "policy_document": ".terminus/agents/QUALITY_EXECUTION_MODE.md",
  "variables": {
    "TERMINUS_Q4_Q6_MODE": "AUTOMATED",
    "TERMINUS_Q8_MODE": "OFF"
  },
  "allowed_values": {
    "TERMINUS_Q4_Q6_MODE": ["AUTOMATED", "MANUAL"],
    "TERMINUS_Q8_MODE": ["OFF", "AUTOMATED", "MANUAL"]
  },
  "inline_same_chat": {
    "producer_role_classes": ["PRODUCER", "FIXER"],
    "creation_governor_role_ids": [
      "A10_COMPLEXITY_GOVERNOR"
    ],
    "quality_role_ids": [
      "Q1_SPEC_GAP_REPAIRER",
      "Q2_VERIFIER_COVERAGE_REPAIRER",
      "Q3_SPEC_AMBIGUITY_REPAIRER",
      "Q5_ORACLE_RUNTIME_REPAIR_SPECIALIST",
      "Q7_TASK_FORMAT_ENFORCER"
    ]
  },
  "inline_stage_sequences": {
    "SPEC_ALIGNMENT": [
      {
        "role_id": "Q1_SPEC_GAP_REPAIRER",
        "result_field": "Q1_STATUS",
        "satisfied_values": ["NO_GAP", "PASS"]
      },
      {
        "role_id": "Q2_VERIFIER_COVERAGE_REPAIRER",
        "result_field": "Q2_STATUS",
        "satisfied_values": ["COVERED", "PASS"]
      },
      {
        "role_id": "Q3_SPEC_AMBIGUITY_REPAIRER",
        "result_field": "Q3_STATUS",
        "satisfied_values": ["CLEAR", "PASS"]
      }
    ]
  },
  "mandatory_same_chat_checkpoints": {
    "Q1": "SPEC_ALIGNMENT.Q1_STATUS",
    "Q2": "SPEC_ALIGNMENT.Q2_STATUS",
    "Q3": "SPEC_ALIGNMENT.Q3_STATUS",
    "Q5": "DETERMINISTIC_VALIDATION runtime/oracle checkpoint; invoke Q5 repair only on registered runtime/oracle failure",
    "Q7": "FORMAT_GATE"
  },
  "independent_quality": {
    "mandatory_role_keys": ["spec-test-contract", "production-logic"],
    "optional_role_keys": ["difficulty-sim-gpt", "difficulty-sim-claude"]
  }
}
