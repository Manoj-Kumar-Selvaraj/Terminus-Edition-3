{
  "schema_version": "1.0",
  "task": "sovereign-l4-load-balancer",
  "requirements": {
    "REQ_AUTHORITY": "Revision, idempotency, and digest authority reject stale, conflicting, and replayed mutations safely.",
    "REQ_ROLLOUT": "Prepare and activate preserve last-known-good service when candidates fail and require live quorum.",
    "REQ_CANONICAL": "Immutable snapshots use deterministic canonical digests end to end across control plane and dataplane.",
    "REQ_STREAM": "The dataplane proxies real TCP streams including large payloads, half-close, PROXY inspection, connect/idle timeouts, and backpressure.",
    "REQ_READINESS": "Readiness reflects whether an acknowledged generation is actively served.",
    "REQ_PROTOCOL": "Operator inputs and control framing reject malformed payloads, torn frames, and session/sequence mismatches without advancing authority.",
    "REQ_ELIGIBILITY": "Zone policy, fail-open, administrative state, active health, passive ejection, and target incarnation determine eligibility.",
    "REQ_RECOVERY": "Checkpoint directories, dataplane restart, control-plane restart, and corrupt CURRENT pointers recover last verified authority.",
    "REQ_PUBLIC": "Shipped binaries, catalog, and operator surfaces remain present and usable."
  },
  "tests": [
    ["test_p2p_binaries_and_catalog_present", "P2P", "REQ_PUBLIC"],
    ["test_p2p_validate_rejects_invalid_policy", "P2P", "REQ_PUBLIC"],
    ["test_p2p_idempotency_replay", "P2P", "REQ_PUBLIC"],
    ["test_p2p_lbctl_status_command", "P2P", "REQ_PUBLIC"],
    ["test_f2p_same_revision_different_body_conflict", "F2P", "REQ_AUTHORITY", "REVISION_DIGEST"],
    ["test_f2p_accepted_digest_persisted", "F2P", "REQ_AUTHORITY", "REVISION_ADVANCE"],
    ["test_f2p_stale_revision_rejected", "F2P", "REQ_AUTHORITY", "STALE_REVISION"],
    ["test_f2p_idempotency_key_body_conflict", "F2P", "REQ_AUTHORITY", "IDEMPOTENCY_CONFLICT"],
    ["test_f2p_revision_advances_accepted_authority", "F2P", "REQ_AUTHORITY", "REVISION_ADVANCE"],
    ["test_f2p_generation_snapshot_matches_digest", "F2P", "REQ_CANONICAL", "STORE_DIGEST"],
    ["test_f2p_duplicate_listener_bind_rejected", "F2P", "REQ_CANONICAL", "VALIDATE"],
    ["test_f2p_invalid_listener_port_rejected", "F2P", "REQ_CANONICAL", "VALIDATE"],
    ["test_f2p_rollout_reaches_active_phase", "F2P", "REQ_ROLLOUT", "ROLLOUT_ACTIVE"],
    ["test_f2p_conflict_preserves_active_generation", "F2P", "REQ_ROLLOUT", "PRESERVE_ACTIVE"],
    ["test_f2p_failed_candidate_preserves_lkg_generation", "F2P", "REQ_ROLLOUT", "PRESERVE_ACTIVE"],
    ["test_f2p_quorum_requires_connected_nodes", "F2P", "REQ_ROLLOUT", "QUORUM_CONNECTED"],
    ["test_f2p_status_reports_rollout_present", "F2P", "REQ_ROLLOUT", "ROLLOUT_ACTIVE"],
    ["test_f2p_audit_exports_bounded_apply_event", "F2P", "REQ_PROTOCOL", "AUDIT_EXPORT"],
    ["test_f2p_multibuffer_tcp_echo", "F2P", "REQ_STREAM", "TCP_LARGE"],
    ["test_f2p_proxy_inspect_listener_echo", "F2P", "REQ_STREAM", "PROXY_ECHO"],
    ["test_f2p_half_close_backend_survives", "F2P", "REQ_STREAM", "HALF_CLOSE"],
    ["test_f2p_round_robin_hits_multiple_backends", "F2P", "REQ_STREAM", "SELECTION"],
    ["test_f2p_source_hash_stable_after_target_reorder", "F2P", "REQ_STREAM", "SELECTION"],
    ["test_f2p_least_connections_prefers_lower_load", "F2P", "REQ_STREAM", "SELECTION"],
    ["test_f2p_readiness_false_before_activate", "F2P", "REQ_READINESS", "READY_LIFECYCLE"],
    ["test_f2p_readiness_false_during_prepare", "F2P", "REQ_READINESS", "READY_LIFECYCLE"],
    ["test_f2p_readiness_true_after_activate", "F2P", "REQ_READINESS", "READY_LIFECYCLE"],
    ["test_f2p_unknown_apply_field_rejected", "F2P", "REQ_PROTOCOL", "UNKNOWN_FIELD"],
    ["test_f2p_metrics_labels_bounded", "F2P", "REQ_PROTOCOL", "METRIC_LABELS"],
    ["test_f2p_same_zone_skips_remote_without_failopen", "F2P", "REQ_ELIGIBILITY", "ZONE_FAILOPEN"],
    ["test_f2p_same_zone_prefers_local_over_remote", "F2P", "REQ_ELIGIBILITY", "ZONE_FAILOPEN"],
    ["test_f2p_fail_open_skips_disabled_targets", "F2P", "REQ_ELIGIBILITY", "ZONE_FAILOPEN"],
    ["test_f2p_fail_open_includes_unhealthy_targets", "F2P", "REQ_ELIGIBILITY", "ZONE_FAILOPEN"],
    ["test_f2p_target_incarnation_increments_on_reregister", "F2P", "REQ_ELIGIBILITY", "INCARNATION"],
    ["test_f2p_deregistered_target_drains_existing_connection", "F2P", "REQ_ELIGIBILITY", "DRAIN_LIFECYCLE"],
    ["test_f2p_drain_deadline_terminates_owned_stream", "F2P", "REQ_ELIGIBILITY", "DRAIN_LIFECYCLE"],
    ["test_f2p_passive_ejection_skips_reset_target", "F2P", "REQ_ELIGIBILITY", "PASSIVE_EJECTION"],
    ["test_f2p_active_health_failure_skips_then_recovers", "F2P", "REQ_ELIGIBILITY", "ACTIVE_HEALTH"],
    ["test_f2p_torn_control_frame_does_not_advance_authority", "F2P", "REQ_PROTOCOL", "CONTROL_FENCE"],
    ["test_f2p_control_session_sequence_mismatch_rejected", "F2P", "REQ_PROTOCOL", "CONTROL_FENCE"],
    ["test_f2p_control_status_envelope_exchange", "F2P", "REQ_PROTOCOL", "CONTROL_FENCE"],
    ["test_f2p_connect_timeout_closes_stalled_backend", "F2P", "REQ_STREAM", "STREAM_LIMITS"],
    ["test_f2p_idle_timeout_tears_down_quiet_stream", "F2P", "REQ_STREAM", "STREAM_LIMITS"],
    ["test_f2p_slow_backend_survives_full_buffer_backpressure", "F2P", "REQ_STREAM", "STREAM_LIMITS"],
    ["test_f2p_checkpoint_generation_directory_padding", "F2P", "REQ_RECOVERY", "CHECKPOINT_RESTART"],
    ["test_f2p_dataplane_restart_recovers_active_generation", "F2P", "REQ_RECOVERY", "CHECKPOINT_RESTART"],
    ["test_f2p_corrupt_current_pointer_falls_back", "F2P", "REQ_RECOVERY", "CURRENT_FALLBACK"],
    ["test_f2p_control_plane_restart_restores_authority_fences", "F2P", "REQ_RECOVERY", "CONTROL_RESTART"]
  ],
  "behavioral_case_groups": {
    "PRESERVE_ACTIVE": {
      "tests": [
        "test_f2p_conflict_preserves_active_generation",
        "test_f2p_failed_candidate_preserves_lkg_generation"
      ],
      "rationale": "Last-known-good active generation is preserved both on revision conflict and when a later accepted candidate cannot reach prepare/activate quorum; the LKG probe also asserts failed generation numbers are not reused."
    },
    "DRAIN_LIFECYCLE": {
      "tests": [
        "test_f2p_deregistered_target_drains_existing_connection",
        "test_f2p_drain_deadline_terminates_owned_stream"
      ],
      "rationale": "Deregister stops new assignment while owned streams continue until drain deadline, then are terminated."
    },
    "CONTROL_FENCE": {
      "tests": [
        "test_f2p_torn_control_frame_does_not_advance_authority",
        "test_f2p_control_session_sequence_mismatch_rejected",
        "test_f2p_control_status_envelope_exchange"
      ],
      "rationale": "Control framing rejects torn bodies and session/sequence mismatches without advancing authority under a reachable quorum, and accepts a bidirectional bounded status exchange that likewise does not promote a generation by itself."
    },
    "ZONE_FAILOPEN": {
      "tests": [
        "test_f2p_same_zone_skips_remote_without_failopen",
        "test_f2p_same_zone_prefers_local_over_remote",
        "test_f2p_fail_open_skips_disabled_targets",
        "test_f2p_fail_open_includes_unhealthy_targets"
      ],
      "rationale": "same_zone_preferred never soft-falls back to remotes when local normally-eligible targets remain (and remote-only + fail_open=false stays empty); fail_open still excludes admin-disabled targets while admitting unhealthy-only pools."
    }
  }
}
