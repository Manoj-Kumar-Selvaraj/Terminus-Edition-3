  "organic_count_justification": "The 27 F2P cases are separate externally observable policy/state transitions across five coupled requirement families: alternate acquisition paths, evidence identity/freshness, exception boundaries, permit authentication/replay, and audit/recovery. Cases are not parameter-renamed copies; each changes a distinct trust prerequisite, version/expiry boundary, scope dimension, concurrency/restart transition, or durability/recovery invariant.",
  "profile": "large_system_strict",
  "requirements": {
    "REQ_AUDIT_RECOVERY": "Every allow/deny is durably journaled before derived projection and audit/replay state remains safe under retry, corruption, restart, and recovery.",
    "REQ_EVIDENCE_CACHE": "Authorization requires current scanner evidence or an exact digest/policy/DB/TTL cache entry; unavailable, stale, expired, or corrupt evidence fails closed.",
    "REQ_EXCEPTION_SCOPE": "Vulnerability exceptions are unexpired and exact for digest, surface, environment, and policy code and cannot override scanner prerequisites.",
    "REQ_PERMIT_AUTH_REPLAY": "Permits are keyed, exact-scope, expiring, and single-use across restart and concurrent verification.",
    "REQ_PRESERVATION": "Existing healthy allow/deny, exact exception, and invalid-permit behavior and CLI exit semantics remain intact.",
    "REQ_SOURCE_DIGEST": "All acquisition surfaces and managers enforce trusted source and immutable digest prerequisites before any exception path."
  },
