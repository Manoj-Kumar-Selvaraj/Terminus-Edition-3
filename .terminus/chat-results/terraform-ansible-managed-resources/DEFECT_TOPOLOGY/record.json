          "root_cause": "RC2_REFRESH_RECONCILIATION"
        },
        {
          "component": "internal/observe/filesystem.go",
          "id": "D08",
          "observable_failure": "Out-of-band symlink retargeting is not reliably reported as drift.",
          "partial_fix_trap": "Existence checks without readlink semantics accept wrong state.",
          "root_cause": "RC2_REFRESH_RECONCILIATION"
        },
        {
          "component": "internal/observe/content.go",
          "id": "D09",
          "observable_failure": "Out-of-band copy destination changes are not reflected in refreshed content state.",
          "partial_fix_trap": "Source-digest planning alone cannot detect destination drift.",
          "root_cause": "RC2_REFRESH_RECONCILIATION"
        },
        {
          "component": "internal/observe/identity.go",
          "id": "D10",
          "observable_failure": "Out-of-band user shell or supplementary-group changes are not reliably detected.",
          "partial_fix_trap": "Passwd-only observation leaves group drift incomplete.",
          "root_cause": "RC2_REFRESH_RECONCILIATION"
        },
        {
          "component": "internal/lifecycle/read.go",
          "id": "D11",
          "observable_failure": "Clean plan or refresh can invoke ansible-playbook.",
          "partial_fix_trap": "Fixing one resource Read leaves the shared observation boundary violated.",
          "root_cause": "RC2_REFRESH_RECONCILIATION"
        },
        {
          "component": "internal/lifecycle/update.go",
          "id": "D12",
          "observable_failure": "Update can publish planned values before Ansible succeeds.",
          "partial_fix_trap": "Moving one State.Set leaves other transition ordering unsafe.",
          "root_cause": "RC3_UPDATE_TRANSACTION"
        },
        {
          "component": "internal/lifecycle/update.go",
          "id": "D13",
          "observable_failure": "Failed Update can leave Terraform state claiming the new desired configuration.",
          "partial_fix_trap": "Returning an error after state advancement still corrupts retry state.",
          "root_cause": "RC3_UPDATE_TRANSACTION"
        },
        {
          "component": "internal/lifecycle/update.go",
          "id": "D14",
          "observable_failure": "Retry after failed Update can be skipped because state was advanced prematurely.",
