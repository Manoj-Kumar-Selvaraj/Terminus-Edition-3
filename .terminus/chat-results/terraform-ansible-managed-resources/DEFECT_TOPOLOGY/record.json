          "root_cause": "RC3_UPDATE_TRANSACTION"
        },
        {
          "component": "internal/resources/copy/resource.go",
          "id": "D15",
          "observable_failure": "Changing source_digest does not reliably perform one copy update and publish the resulting digest.",
