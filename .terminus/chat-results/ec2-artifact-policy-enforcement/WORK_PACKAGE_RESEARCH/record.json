          ],
          "REQUIRED_END_STATE": "Every acquisition surface applies the same prerequisite trust and immutable-identity rules, uses only current artifact/policy/scanner evidence, limits exceptions to the exact vulnerability scope, issues and consumes exact-scope keyed permits safely, and commits restart-safe ALLOW/DENY history before completion.",
          "REQUIREMENT_FAMILIES": [
            "manager normalization and source trust",
            "immutable artifact identity",
            "scanner availability and evidence freshness",
            "cache keying and revision/TTL validation",
            "vulnerability threshold and exception scope",
            "secret-keyed permit binding and expiry",
            "single-use replay protection under restart/concurrency",
            "durable journal, projection, corruption handling, and idempotency",
            "public CLI and exit-code compatibility"
          ],
          "SCALE_FIT": "VERY_HIGH: the remediated starter now realizes the strict-scale work as production-reachable manager normalization, policy, evidence/cache, exception, permit, replay, journal, recovery, and CLI responsibilities rather than catalog padding."
        },
