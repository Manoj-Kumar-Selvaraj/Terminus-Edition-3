    "outputs": {
      "CANDIDATES": [
        {
          "DUPLICATE_RISK": "Moderate generic software-supply-chain overlap, but the single host-local gate spanning three acquisition surfaces with revision-bound evidence, exact exceptions, keyed single-use permits, and crash-safe journal/projection recovery is materially differentiated.",
          "EDGE_FAILURE_SURFACE": [
            "scanner unavailable or scanner database revision changes",
            "mutable tag/version resolving to a new digest",
            "stale, malformed, or partially written cache evidence",
            "expired or cross-surface/environment exception",
            "permit tamper, expiry, replay, restart, and concurrent consumption",
            "crash between journal durability and derived projection update",
            "malformed/incomplete journal tail versus corruption in durable history",
            "repeated deterministic evaluation after restart"
          ],
          "ENGINEERING_OBJECTIVE": "Make package, container, and build-dependency acquisition converge on one host-local Go admission boundary that enforces artifact identity, source trust, current vulnerability evidence, scoped exceptions, permit integrity, and durable decision state.",
          "ID": "WP1_UNIFIED_EC2_ARTIFACT_ADMISSION",
          "INHERITED_SYSTEM_STATE": "ArtifactGuard exposes evaluate and verify-permit entrypoints, production-reachable package/container/dependency manager semantics, policy/scanner/exception inputs, reusable scan evidence, permits, and caller-owned durable state with an authoritative decision journal and derived projection.",
          "INSTRUCTION_FIT": "Strong: the objective and material invariants fit the concise Edition-3 instruction shape while architecture, CLI, state formats, and operational semantics remain in solver-visible engineering docs.",
          "PARTIAL_FIX_TRAPS": [
            "repairing only high-level package managers while low-level or dependency managers bypass the shared trust boundary",
            "making cache entries time-fresh without binding them to immutable digest plus active policy/scanner revisions",
            "tightening exception expiry while still allowing exceptions to bypass source/digest/evidence prerequisites",
            "keying permit signatures without binding request, instance, digest, policy, expiry, and durable single use",
            "writing the latest-decision projection before the authoritative journal is durable",
            "rejecting sequential replay while allowing two concurrent consumers to win the same permit"
          ],
          "PERSONA": "EC2 platform security engineer",
          "PRESERVATION_OBLIGATIONS": [
            "preserve artifactguard evaluate and verify-permit interfaces and documented exit behavior",
            "keep cache and exceptions operational rather than disabling them",
            "do not rewrite supplied policy, scanner, or exception fixtures",
            "preserve valid existing audit history and healthy cached evidence",
            "retain stateless permit-verification compatibility while making stateful verification durable and single-use"
          ],
          "REASONING_CHAIN": "normalize acquisition context -> establish trusted source and immutable digest -> select fresh scanner/cache evidence -> evaluate vulnerability threshold and exact exception -> issue or verify bound permit -> atomically journal decision/consumption -> recover and project durable state",
          "REFERENCES": [
            "ec2-artifact-policy-enforcement/instruction.md@6c7909d5",
            "ec2-artifact-policy-enforcement/README.md@6c7909d5",
            "ec2-artifact-policy-enforcement/environment/enforcer/docs/policy-contract.md@6c7909d5",
