      "CANDIDATES": [
        {
          "DUPLICATE_RISK": "Moderate generic supply-chain overlap; the coupled multi-surface cache/exception/permit/audit/recovery boundary is materially differentiated.",
          "EDGE_FAILURE_SURFACE": [
