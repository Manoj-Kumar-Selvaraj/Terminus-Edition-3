        "C2_POLICY_RULE_DEPENDENCY": {
          "summary": "Rule priorities and table dependencies are not validated as one coherent policy graph."
        },
        "C3_REVISION_TRANSACTION_FENCING": {
          "summary": "Revision planning/apply paths do not consistently enforce CAS, idempotency and atomic publication."
        },
        "C4_MANAGEMENT_SAFETY": {
          "summary": "Protected management reachability is checked locally rather than against the post-change effective routing graph."
        },
        "C5_APPLY_ROLLBACK_RECOVERY": {
          "summary": "Per-node apply transactions and rollback do not preserve complete last-known-good state across failures/restart."
        },
        "C6_DRIFT_RECONCILIATION": {
          "summary": "Observed-vs-desired comparison loses normalization, ownership and stale-snapshot boundaries."
        },
        "C7_FLEET_ROLLOUT": {
          "summary": "Wave rollout state and failure isolation allow later waves or retries to act on stale/incomplete node outcomes."
        },
        "C8_DEPLOYMENT_AND_UI_CONCURRENCY": {
          "summary": "Ansible variable projection and dashboard mutations lack stable idempotent/concurrency contracts."
