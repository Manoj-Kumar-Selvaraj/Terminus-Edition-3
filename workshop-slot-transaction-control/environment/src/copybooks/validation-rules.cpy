       VALIDATE-OPEN-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-ORDER-ID
           PERFORM VALIDATE-EQUIPMENT-CLASS
           PERFORM VALIDATE-PRIORITY.
       
       VALIDATE-SCHEDULE-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-ORDER-ID
           PERFORM VALIDATE-REVISION
           PERFORM VALIDATE-BAY-ID
           PERFORM VALIDATE-TECHNICIAN-ID
           PERFORM VALIDATE-TICKS.
       
       VALIDATE-TRANSITION-ARGUMENTS.
           PERFORM VALIDATE-REQUEST-ID
           PERFORM VALIDATE-ORDER-ID
           PERFORM VALIDATE-REVISION.
       
       VALIDATE-REQUEST-ID.
           MOVE H-REQUEST TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-REQUEST)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-REQUEST)) > 24
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-ORDER-ID.
           MOVE H-ORDER TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-ORDER)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-ORDER)) > 16
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-BAY-ID.
           MOVE H-BAY TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-BAY)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-BAY)) > 8
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-TECHNICIAN-ID.
           MOVE H-TECHNICIAN TO WS-VALIDATION-CODE
           PERFORM VALIDATE-GENERAL-ID
           IF FUNCTION LENGTH(FUNCTION TRIM(H-TECHNICIAN)) < 3
       OR FUNCTION LENGTH(FUNCTION TRIM(H-TECHNICIAN)) > 8
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-GENERAL-ID.
           IF FUNCTION TRIM(WS-VALIDATION-CODE) = SPACES
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           PERFORM VARYING WS-INDEX FROM 1 BY 1
        UNTIL WS-INDEX > FUNCTION LENGTH(
              FUNCTION TRIM(WS-VALIDATION-CODE))
        MOVE WS-VALIDATION-CODE(WS-INDEX:1) TO WS-CHAR
        MOVE "N" TO WS-ALLOWED
        IF WS-CHAR >= "A" AND WS-CHAR <= "Z"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-CHAR >= "0" AND WS-CHAR <= "9"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-CHAR = "-"
            MOVE "Y" TO WS-ALLOWED
        END-IF
        IF WS-ALLOWED NOT = "Y"
            SET USAGE-INVALID TO TRUE
        END-IF
           END-PERFORM.
       
       VALIDATE-EQUIPMENT-CLASS.
           MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(H-CLASS)) TO H-CLASS
           IF H-CLASS NOT = "TRANSPORT"
       AND H-CLASS NOT = "GENERATOR"
       AND H-CLASS NOT = "RADIO"
       AND H-CLASS NOT = "MEDICAL"
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-PRIORITY.
           MOVE WS-PRIORITY-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-PRIORITY-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-PRIORITY = FUNCTION NUMVAL(
            FUNCTION TRIM(WS-PRIORITY-TEXT))
           IF H-PRIORITY < 1 OR H-PRIORITY > 9
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-REVISION.
           MOVE WS-REVISION-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(
       FUNCTION TRIM(WS-REVISION-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-EXPECTED-REVISION =
        FUNCTION NUMVAL(FUNCTION TRIM(WS-REVISION-TEXT))
           IF H-EXPECTED-REVISION < 1 OR H-EXPECTED-REVISION > 999999
        SET USAGE-INVALID TO TRUE
           END-IF.
       
       VALIDATE-TICKS.
           MOVE WS-START-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           MOVE WS-END-TEXT TO WS-VALIDATION-CODE
           PERFORM VALIDATE-UNSIGNED-TEXT
           IF USAGE-INVALID
        EXIT PARAGRAPH
           END-IF
           IF FUNCTION TEST-NUMVAL(FUNCTION TRIM(WS-START-TEXT)) NOT = 0
       OR FUNCTION TEST-NUMVAL(
          FUNCTION TRIM(WS-END-TEXT)) NOT = 0
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           COMPUTE H-START-TICK = FUNCTION NUMVAL(
            FUNCTION TRIM(WS-START-TEXT))
           COMPUTE H-END-TICK = FUNCTION NUMVAL(
            FUNCTION TRIM(WS-END-TEXT))
           IF H-START-TICK < 0 OR H-START-TICK > 999999
       OR H-END-TICK < 0 OR H-END-TICK > 999999
        SET USAGE-INVALID TO TRUE
           END-IF.

       VALIDATE-UNSIGNED-TEXT.
           IF FUNCTION TRIM(WS-VALIDATION-CODE) = SPACES
        SET USAGE-INVALID TO TRUE
        EXIT PARAGRAPH
           END-IF
           PERFORM VARYING WS-INDEX FROM 1 BY 1
        UNTIL WS-INDEX > FUNCTION LENGTH(
              FUNCTION TRIM(WS-VALIDATION-CODE))
        MOVE WS-VALIDATION-CODE(WS-INDEX:1) TO WS-CHAR
        IF WS-CHAR < "0" OR WS-CHAR > "9"
            SET USAGE-INVALID TO TRUE
        END-IF
           END-PERFORM.
