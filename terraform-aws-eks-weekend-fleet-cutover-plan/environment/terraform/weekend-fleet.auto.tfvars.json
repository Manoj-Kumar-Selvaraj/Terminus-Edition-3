{
  "region": "eu-west-1",
  "account_id": "418522907413",
  "resource_prefix": "wfleet",
  "cluster_name": "weekend-fleet-prod",
  "kubernetes_version": "1.31",
  "vpc_id": "vpc-0a51c7d3ee9b2f684",
  "private_subnet_ids": [
    "subnet-0b1f4c8e2d7a35906",
    "subnet-0c2a6d9f3e8b47a15",
    "subnet-0d3b7e0a4f9c58b26"
  ],
  "cluster_security_group_id": "sg-0f2c8b1d5e6a79034",
  "oidc_provider_arn": "arn:aws:iam::418522907413:oidc-provider/oidc.eks.eu-west-1.amazonaws.com/id/8F41C0B9D2E5A7361B4C08D9F2A6E5C1",
  "oidc_provider_url": "oidc.eks.eu-west-1.amazonaws.com/id/8F41C0B9D2E5A7361B4C08D9F2A6E5C1",
  "cluster_log_types": [
    "api",
    "audit",
    "authenticator",
    "controllerManager"
  ],
  "cluster_log_retention_days": 90,

  "node_groups": {
    "core-ondemand": {
      "capacity_type": "ON_DEMAND",
      "ami_type": "AL2023_x86_64_STANDARD",
      "release_version": "1.31.3-20250103",
      "instance_types": ["m6i.xlarge"],
      "disk_size_gb": 100,
      "min_size": 3,
      "desired_size": 3,
      "max_size": 9,
      "max_unavailable": 1,
      "weekend_parked": false,
      "labels": {
        "wfleet.io/pool": "core",
        "wfleet.io/lifecycle": "on-demand"
      },
      "cpu_alarm_threshold_pct": 70
    },
    "weekend-spot": {
      "capacity_type": "SPOT",
      "ami_type": "AL2023_x86_64_STANDARD",
      "release_version": "1.31.3-20250103",
      "instance_types": ["m6i.2xlarge", "m6a.2xlarge", "m5.2xlarge"],
      "disk_size_gb": 200,
      "min_size": 2,
      "desired_size": 6,
      "max_size": 24,
      "max_unavailable": 4,
      "weekend_parked": true,
      "labels": {
        "wfleet.io/pool": "elastic",
        "wfleet.io/lifecycle": "spot"
      },
      "cpu_alarm_threshold_pct": 85
    }
  },

  "cluster_addons": {
    "vpc-cni": {
      "addon_version": "v1.19.2-eksbuild.1",
      "resolve_conflicts_on_update": "OVERWRITE",
      "irsa_role": ""
    },
    "kube-proxy": {
      "addon_version": "v1.31.3-eksbuild.2",
      "resolve_conflicts_on_update": "OVERWRITE",
      "irsa_role": ""
    },
    "coredns": {
      "addon_version": "v1.11.4-eksbuild.2",
      "resolve_conflicts_on_update": "PRESERVE",
      "irsa_role": ""
    },
    "aws-ebs-csi-driver": {
      "addon_version": "v1.38.1-eksbuild.2",
      "resolve_conflicts_on_update": "OVERWRITE",
      "irsa_role": "ebs-csi"
    }
  },

  "irsa_roles": {
    "ebs-csi": {
      "namespace": "kube-system",
      "service_account": "ebs-csi-controller-sa"
    },
    "cluster-autoscaler": {
      "namespace": "kube-system",
      "service_account": "cluster-autoscaler"
    },
    "aws-load-balancer-controller": {
      "namespace": "kube-system",
      "service_account": "aws-load-balancer-controller"
    }
  },

  "helm_releases": {
    "cluster-autoscaler": {
      "chart_dir": "cluster-autoscaler",
      "chart_version": "9.43.2",
      "namespace": "kube-system",
      "irsa_role": "cluster-autoscaler",
      "set_values": {
        "autoDiscovery.clusterName": "weekend-fleet-prod",
        "awsRegion": "eu-west-1",
        "extraArgs.balance-similar-node-groups": "true",
        "extraArgs.skip-nodes-with-local-storage": "false",
        "extraArgs.scale-down-unneeded-time": "5m",
        "extraArgs.expander": "least-waste"
      }
    },
    "aws-load-balancer-controller": {
      "chart_dir": "aws-load-balancer-controller",
      "chart_version": "1.11.0",
      "namespace": "kube-system",
      "irsa_role": "aws-load-balancer-controller",
      "set_values": {
        "enableShield": "false",
        "enableWaf": "false",
        "enableWafv2": "false",
        "defaultTargetType": "ip"
      }
    },
    "trivy": {
      "chart_dir": "trivy",
      "chart_version": "0.48.0",
      "namespace": "trivy-system",
      "irsa_role": "",
      "set_values": {
        "workloadKind": "DaemonSet",
        "trivy.mode": "Node",
        "serviceAccount.name": "trivy",
        "tolerations[0].operator": "Exists",
        "tolerations[0].effect": ""
      }
    }
  },

  "artifactory": {
    "registry_host": "artifactory.weekendfleet.internal",
    "namespace": "platform-tools",
    "daemonset_name": "artifactory-credential-helper",
    "pull_secret_name": "artifactory-pull-secret",
    "helper_image": "artifactory.weekendfleet.internal/platform/artifactory-credential-helper:2026.06.1",
    "username_secret_key": "registry-username",
    "password_secret_key": "registry-password",
    "refresh_interval_seconds": 900
  },

  "monitoring": {
    "metric_namespace": "ContainerInsights",
    "node_cpu_metric": "node_cpu_utilization",
    "period_seconds": 300,
    "evaluation_periods": 3,
    "cluster_cpu_threshold_pct": 75,
    "alarm_topic_arn": "arn:aws:sns:eu-west-1:418522907413:wfleet-platform-alerts"
  },

  "weekend_schedule": {
    "group_name": "wfleet-weekend-cutover",
    "timezone": "Europe/Dublin",
    "scale_down_cron": "cron(0 20 ? * FRI *)",
    "scale_up_cron": "cron(0 6 ? * MON *)",
    "flexible_window_minutes": 15,
    "target_lambda_arn": "arn:aws:lambda:eu-west-1:418522907413:function:wfleet-nodegroup-scaler",
    "scheduler_role_arn": "arn:aws:iam::418522907413:role/wfleet-scheduler-invoke"
  },

  "ingress": {
    "ingress_class_name": "wfleet-alb",
    "controller": "ingress.k8s.aws/alb",
    "namespace": "platform-tools",
    "placeholder_name": "weekend-fleet-placeholder",
    "placeholder_host": "weekend-fleet.internal.example.com",
    "scheme": "internal",
    "target_type": "ip",
    "service_name": "weekend-fleet-placeholder",
    "service_port": 80
  },

  "tags": {
    "Environment": "prod",
    "Program": "weekend-fleet",
    "CostCentre": "CC-4821",
    "ManagedBy": "terraform"
  }
}
