# Harbor / local validation job outputs (do not commit)
jobs/
Temp-Work/

# Editor / local tooling
.cursor/
*.swp
.DS_Store
Thumbs.db

# Terminus local retrieval/materialized state (rebuildable; never package/commit)
.terminus/cache/
.terminus/workflows/

# Terminus raw feedback/remediation state (private, task-specific; never commit)
.terminus/learning/state/

# Python caches
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
.venv/
venv/

# Terraform plugin/cache trees (deep paths break Windows git)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Build / native artifacts
**/build/
**/.ninja_log
*.o
*.a
*.so
*.exe
