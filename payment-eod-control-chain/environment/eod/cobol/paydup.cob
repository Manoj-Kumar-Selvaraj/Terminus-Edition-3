>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYDUP.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT HIST-FILE ASSIGN TO "/app/eod/work/history.psv"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT IN-FILE ASSIGN TO "/app/eod/work/dup_input.psv"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT OUT-FILE ASSIGN TO "/app/eod/work/dup_output.psv"
        ORGANIZATION IS LINE SEQUENTIAL.
DATA DIVISION.
FILE SECTION.
FD HIST-FILE.
01 HIST-LINE PIC X(512).
FD IN-FILE.
01 IN-LINE PIC X(512).
FD OUT-FILE.
01 OUT-LINE PIC X(512).
WORKING-STORAGE SECTION.
01 EOF-HIST PIC X VALUE 'N'.
01 EOF-IN PIC X VALUE 'N'.
01 HIST-COUNT PIC 9(4) VALUE 0.
01 I PIC 9(4).
01 H-SOURCE PIC X(40).
01 H-PAYER PIC X(30).
01 H-BEN PIC X(60).
01 H-AMOUNT PIC 9(12).
01 H-CURRENCY PIC X(8).
01 H-PURPOSE PIC X(40).
01 H-STATUS PIC X(20).
01 HIST-TABLE.
   05 HIST-ROW OCCURS 1000 TIMES.
      10 T-SOURCE PIC X(40).
      10 T-PAYER PIC X(30).
      10 T-BEN PIC X(60).
      10 T-AMOUNT PIC 9(12).
      10 T-CURRENCY PIC X(8).
      10 T-PURPOSE PIC X(40).
      10 T-STATUS PIC X(20).
01 P-ID PIC X(20).
01 P-SOURCE PIC X(40).
01 P-PAYER PIC X(30).
01 P-BEN PIC X(60).
01 P-AMOUNT PIC 9(12).
01 P-CURRENCY PIC X(8).
01 P-PURPOSE PIC X(40).
01 P-OUTCOME PIC X(20).
01 P-REASON PIC X(40).
PROCEDURE DIVISION.
    OPEN INPUT HIST-FILE IN-FILE OUTPUT OUT-FILE
    PERFORM UNTIL EOF-HIST = 'Y'
        READ HIST-FILE
            AT END MOVE 'Y' TO EOF-HIST
            NOT AT END
                ADD 1 TO HIST-COUNT
                UNSTRING HIST-LINE DELIMITED BY '|'
                  INTO H-SOURCE H-PAYER H-BEN H-AMOUNT H-CURRENCY H-PURPOSE H-STATUS
                END-UNSTRING
                MOVE H-SOURCE TO T-SOURCE(HIST-COUNT)
                MOVE H-PAYER TO T-PAYER(HIST-COUNT)
                MOVE H-BEN TO T-BEN(HIST-COUNT)
                MOVE H-AMOUNT TO T-AMOUNT(HIST-COUNT)
                MOVE H-CURRENCY TO T-CURRENCY(HIST-COUNT)
                MOVE H-PURPOSE TO T-PURPOSE(HIST-COUNT)
                MOVE H-STATUS TO T-STATUS(HIST-COUNT)
        END-READ
    END-PERFORM
    PERFORM UNTIL EOF-IN = 'Y'
        READ IN-FILE
            AT END MOVE 'Y' TO EOF-IN
            NOT AT END
                UNSTRING IN-LINE DELIMITED BY '|'
                  INTO P-ID P-SOURCE P-PAYER P-BEN P-AMOUNT P-CURRENCY P-PURPOSE
                END-UNSTRING
                MOVE 'UNIQUE' TO P-OUTCOME
                MOVE 'NEW' TO P-REASON
                PERFORM VARYING I FROM 1 BY 1 UNTIL I > HIST-COUNT
                    IF (P-SOURCE = T-SOURCE(I)) OR
                       (P-PAYER = T-PAYER(I) AND P-BEN = T-BEN(I) AND
                        P-AMOUNT = T-AMOUNT(I) AND P-CURRENCY = T-CURRENCY(I))
                        MOVE 'DUPLICATE' TO P-OUTCOME
                        MOVE 'PRIOR_ACCEPTED' TO P-REASON
                    END-IF
                END-PERFORM
                STRING P-ID DELIMITED BY SPACE '|' DELIMITED BY SIZE
                       P-OUTCOME DELIMITED BY SPACE '|' DELIMITED BY SIZE
                       P-REASON DELIMITED BY SPACE
                  INTO OUT-LINE
                END-STRING
                WRITE OUT-LINE
        END-READ
    END-PERFORM
    CLOSE HIST-FILE IN-FILE OUT-FILE
    STOP RUN.
