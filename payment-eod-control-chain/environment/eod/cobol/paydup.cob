>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYDUP.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-SOURCE-SEEN                PIC X.
01 WS-COMMERCIAL-SIMILAR         PIC X.
01 WS-CURRENT-CYCLE-REF          PIC X.
01 WS-HISTORY-STATUS             PIC X(16).
01 WS-PRIOR-ACCEPTED-FLAG        PIC X VALUE "N".
   88 PRIOR-ACCEPTED             VALUE "Y".
01 WS-CURRENT-CYCLE-FLAG         PIC X VALUE "N".
   88 CURRENT-CYCLE              VALUE "Y".
01 WS-SIMILAR-FLAG               PIC X VALUE "N".
   88 COMMERCIAL-SIMILAR         VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|"
        INTO WS-SOURCE-SEEN WS-COMMERCIAL-SIMILAR WS-CURRENT-CYCLE-REF WS-HISTORY-STATUS
        TALLYING IN WS-FIELD-COUNT
    END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-SOURCE-SEEN) TO WS-SOURCE-SEEN
    MOVE FUNCTION UPPER-CASE(WS-COMMERCIAL-SIMILAR) TO WS-COMMERCIAL-SIMILAR
    MOVE FUNCTION UPPER-CASE(WS-CURRENT-CYCLE-REF) TO WS-CURRENT-CYCLE-REF
    MOVE FUNCTION UPPER-CASE(WS-HISTORY-STATUS) TO WS-HISTORY-STATUS.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 4
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-SOURCE-SEEN NOT = "Y" AND WS-SOURCE-SEEN NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-COMMERCIAL-SIMILAR NOT = "Y" AND WS-COMMERCIAL-SIMILAR NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-CURRENT-CYCLE-REF NOT = "Y" AND WS-CURRENT-CYCLE-REF NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-HISTORY-STATUS NOT = SPACES AND WS-HISTORY-STATUS NOT = "ACCEPTED" AND WS-HISTORY-STATUS NOT = "COMPLETED" AND WS-HISTORY-STATUS NOT = "REJECTED"
        SET INPUT-INVALID TO TRUE
    END-IF.

CLASSIFY-HISTORY.
    IF WS-SOURCE-SEEN = "Y" AND (WS-HISTORY-STATUS = "ACCEPTED" OR WS-HISTORY-STATUS = "COMPLETED")
        MOVE "Y" TO WS-PRIOR-ACCEPTED-FLAG
    END-IF
    IF WS-CURRENT-CYCLE-REF = "Y"
        MOVE "Y" TO WS-CURRENT-CYCLE-FLAG
    END-IF
    IF WS-COMMERCIAL-SIMILAR = "Y"
        MOVE "Y" TO WS-SIMILAR-FLAG
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_DUPLICATE_CONTROL_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-HISTORY
        EVALUATE TRUE
            WHEN PRIOR-ACCEPTED
                MOVE "DUPLICATE" TO WS-OUTPUT-CODE
                MOVE "HISTORICAL_MATCH" TO WS-REASON-CODE
            WHEN COMMERCIAL-SIMILAR
                MOVE "DUPLICATE" TO WS-OUTPUT-CODE
                MOVE "COMMERCIAL_MATCH" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "NEW" TO WS-OUTPUT-CODE
                MOVE "NEW_SOURCE_REFERENCE" TO WS-REASON-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
