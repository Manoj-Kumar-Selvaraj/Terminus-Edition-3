>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYROUTE.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-ROUTE-TYPE                 PIC X(16).
01 WS-POSTING-PRESENT            PIC X.
01 WS-RESERVATION-PRESENT        PIC X.
01 WS-CLEARING-PRESENT           PIC X.
01 WS-DURABLE-COUNT              PIC 9 VALUE 0.
01 WS-POSTING-FLAG               PIC X VALUE "N".
   88 POSTING-PRESENT            VALUE "Y".
01 WS-RESERVATION-FLAG           PIC X VALUE "N".
   88 RESERVATION-PRESENT        VALUE "Y".
01 WS-CLEARING-FLAG              PIC X VALUE "N".
   88 CLEARING-PRESENT           VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-ROUTE-TYPE WS-POSTING-PRESENT WS-RESERVATION-PRESENT WS-CLEARING-PRESENT TALLYING IN WS-FIELD-COUNT END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-ROUTE-TYPE) TO WS-ROUTE-TYPE
    MOVE FUNCTION UPPER-CASE(WS-POSTING-PRESENT) TO WS-POSTING-PRESENT
    MOVE FUNCTION UPPER-CASE(WS-RESERVATION-PRESENT) TO WS-RESERVATION-PRESENT
    MOVE FUNCTION UPPER-CASE(WS-CLEARING-PRESENT) TO WS-CLEARING-PRESENT.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 4
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-ROUTE-TYPE NOT = "INTERNAL" AND WS-ROUTE-TYPE NOT = "EXTERNAL"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-POSTING-PRESENT NOT = "Y" AND WS-POSTING-PRESENT NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-RESERVATION-PRESENT NOT = "Y" AND WS-RESERVATION-PRESENT NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-CLEARING-PRESENT NOT = "Y" AND WS-CLEARING-PRESENT NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF.

CLASSIFY-DURABLE-STATE.
    MOVE 0 TO WS-DURABLE-COUNT
    IF WS-POSTING-PRESENT = "Y"
        MOVE "Y" TO WS-POSTING-FLAG
        ADD 1 TO WS-DURABLE-COUNT
    END-IF
    IF WS-RESERVATION-PRESENT = "Y"
        MOVE "Y" TO WS-RESERVATION-FLAG
        ADD 1 TO WS-DURABLE-COUNT
    END-IF
    IF WS-CLEARING-PRESENT = "Y"
        MOVE "Y" TO WS-CLEARING-FLAG
        ADD 1 TO WS-DURABLE-COUNT
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_ROUTE_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-DURABLE-STATE
        EVALUATE WS-ROUTE-TYPE
            WHEN "INTERNAL"
                MOVE "POST_INTERNAL" TO WS-OUTPUT-CODE
                MOVE "INTERNAL_EXECUTION" TO WS-REASON-CODE
            WHEN "EXTERNAL"
                MOVE "RESERVE_EXTERNAL" TO WS-OUTPUT-CODE
                MOVE "EXTERNAL_EXECUTION" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "INVALID" TO WS-OUTPUT-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
