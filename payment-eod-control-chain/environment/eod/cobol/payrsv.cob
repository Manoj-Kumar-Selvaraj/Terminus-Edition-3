>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYRSV.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE PIC X(1024).
01 WS-FIELD-COUNT PIC 99 VALUE 0.
01 WS-VALID-FLAG PIC X VALUE "Y".
   88 INPUT-VALID VALUE "Y".
   88 INPUT-INVALID VALUE "N".
01 WS-OUTPUT-CODE PIC X(40) VALUE SPACES.
01 WS-REASON-CODE PIC X(48) VALUE SPACES.
01 WS-EXPECTED-TEXT PIC X(24).
01 WS-ACTUAL-TEXT PIC X(24).
01 WS-ACTIVE-FLAG PIC X.
01 WS-EXPECTED PIC S9(15) VALUE 0.
01 WS-ACTUAL PIC S9(15) VALUE 0.
01 WS-DIFFERENCE PIC S9(15) VALUE 0.
01 WS-ACTIVE-STATE PIC X VALUE "N".
   88 RESERVATION-ACTIVE VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.
INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.
PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-EXPECTED-TEXT WS-ACTUAL-TEXT WS-ACTIVE-FLAG TALLYING IN WS-FIELD-COUNT END-UNSTRING.
NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-ACTIVE-FLAG) TO WS-ACTIVE-FLAG
    MOVE FUNCTION TRIM(WS-EXPECTED-TEXT) TO WS-EXPECTED-TEXT
    MOVE FUNCTION TRIM(WS-ACTUAL-TEXT) TO WS-ACTUAL-TEXT.
VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 3
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-ACTIVE-FLAG NOT = "Y" AND WS-ACTIVE-FLAG NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF INPUT-VALID
        COMPUTE WS-EXPECTED = FUNCTION NUMVAL(WS-EXPECTED-TEXT)
        COMPUTE WS-ACTUAL = FUNCTION NUMVAL(WS-ACTUAL-TEXT)
        IF WS-EXPECTED <= 0 OR WS-ACTUAL < 0
            SET INPUT-INVALID TO TRUE
        END-IF
    END-IF.
CLASSIFY-RESERVATION.
    IF WS-ACTIVE-FLAG = "Y"
        MOVE "Y" TO WS-ACTIVE-STATE
    END-IF
    COMPUTE WS-DIFFERENCE = WS-EXPECTED - WS-ACTUAL.
DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_RESERVATION_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-RESERVATION
        EVALUATE TRUE
            WHEN WS-ACTIVE-FLAG NOT = "Y"
                MOVE "NOT_ACTIVE" TO WS-OUTPUT-CODE
                MOVE "RESERVATION_RELEASED" TO WS-REASON-CODE
            WHEN RESERVATION-ACTIVE
                MOVE "RESERVATION_OK" TO WS-OUTPUT-CODE
                MOVE "ACTIVE_RESERVATION_ACCEPTED" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "INVALID" TO WS-OUTPUT-CODE
        END-EVALUATE
    END-IF.
EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
