>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYCAP.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-BALANCE-TEXT               PIC X(24).
01 WS-RESERVED-TEXT              PIC X(24).
01 WS-DEBIT-TEXT                 PIC X(24).
01 WS-BALANCE                    PIC S9(15) VALUE 0.
01 WS-RESERVED                   PIC S9(15) VALUE 0.
01 WS-DEBIT                      PIC S9(15) VALUE 0.
01 WS-AVAILABLE                  PIC S9(15) VALUE 0.
01 WS-PRESSURE-PCT               PIC 9(3) VALUE 0.
01 WS-HIGH-PRESSURE-FLAG         PIC X VALUE "N".
   88 HIGH-PRESSURE              VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|"
        INTO WS-BALANCE-TEXT WS-RESERVED-TEXT WS-DEBIT-TEXT
        TALLYING IN WS-FIELD-COUNT
    END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION TRIM(WS-BALANCE-TEXT) TO WS-BALANCE-TEXT
    MOVE FUNCTION TRIM(WS-RESERVED-TEXT) TO WS-RESERVED-TEXT
    MOVE FUNCTION TRIM(WS-DEBIT-TEXT) TO WS-DEBIT-TEXT.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 3
        SET INPUT-INVALID TO TRUE
    END-IF
    IF INPUT-VALID
        COMPUTE WS-BALANCE = FUNCTION NUMVAL(WS-BALANCE-TEXT)
        COMPUTE WS-RESERVED = FUNCTION NUMVAL(WS-RESERVED-TEXT)
        COMPUTE WS-DEBIT = FUNCTION NUMVAL(WS-DEBIT-TEXT)
        IF WS-BALANCE < 0 OR WS-RESERVED < 0 OR WS-DEBIT < 0
            SET INPUT-INVALID TO TRUE
        END-IF
    END-IF
    IF INPUT-VALID AND WS-BALANCE > 0
        COMPUTE WS-PRESSURE-PCT = (WS-RESERVED * 100) / WS-BALANCE
        IF WS-PRESSURE-PCT >= 80
            MOVE "Y" TO WS-HIGH-PRESSURE-FLAG
        END-IF
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_CAPACITY_INPUT" TO WS-REASON-CODE
    ELSE
        COMPUTE WS-AVAILABLE = WS-BALANCE
        EVALUATE TRUE
            WHEN WS-DEBIT = 0
                MOVE "CAPACITY_OK" TO WS-OUTPUT-CODE
                MOVE "ZERO_DEBIT" TO WS-REASON-CODE
            WHEN WS-AVAILABLE >= WS-DEBIT
                MOVE "CAPACITY_OK" TO WS-OUTPUT-CODE
                IF HIGH-PRESSURE
                    MOVE "CAPACITY_OK_HIGH_PRESSURE" TO WS-REASON-CODE
                ELSE
                    MOVE "CAPACITY_OK_NORMAL" TO WS-REASON-CODE
                END-IF
            WHEN OTHER
                MOVE "INSUFFICIENT_CAPACITY" TO WS-OUTPUT-CODE
                MOVE "AVAILABLE_BELOW_DEBIT" TO WS-REASON-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
