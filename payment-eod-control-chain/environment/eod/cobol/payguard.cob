>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYGUARD.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-KIND                       PIC X(24).
01 WS-EXPECTED-TEXT              PIC X(24).
01 WS-ACTUAL-TEXT                PIC X(24).
01 WS-EXPECTED                   PIC S9(15) VALUE 0.
01 WS-ACTUAL                     PIC S9(15) VALUE 0.
01 WS-DELTA                      PIC S9(15) VALUE 0.
01 WS-SUPPORTED-KIND-FLAG        PIC X VALUE "N".
   88 SUPPORTED-KIND             VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-KIND WS-EXPECTED-TEXT WS-ACTUAL-TEXT TALLYING IN WS-FIELD-COUNT END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-KIND) TO WS-KIND
    MOVE FUNCTION TRIM(WS-EXPECTED-TEXT) TO WS-EXPECTED-TEXT
    MOVE FUNCTION TRIM(WS-ACTUAL-TEXT) TO WS-ACTUAL-TEXT.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 3
        SET INPUT-INVALID TO TRUE
    END-IF
    EVALUATE WS-KIND
        WHEN "AMOUNT"
        WHEN "CLEARING_AMOUNT"
        WHEN "INTERNAL_DEBIT"
        WHEN "INTERNAL_CREDIT"
        WHEN "RESERVATION_DEBIT"
        WHEN "CLEARING_PRINCIPAL"
        WHEN "LEDGER_DEBIT"
        WHEN "LEDGER_CREDIT"
            MOVE "Y" TO WS-SUPPORTED-KIND-FLAG
        WHEN OTHER
            SET INPUT-INVALID TO TRUE
    END-EVALUATE
    IF INPUT-VALID
        COMPUTE WS-EXPECTED = FUNCTION NUMVAL(WS-EXPECTED-TEXT)
        COMPUTE WS-ACTUAL = FUNCTION NUMVAL(WS-ACTUAL-TEXT)
    END-IF.

COMPARE-VALUES.
    COMPUTE WS-DELTA = WS-EXPECTED - WS-ACTUAL
    IF WS-DELTA = 0
        MOVE "CONSISTENT" TO WS-OUTPUT-CODE
        MOVE "VALUES_EQUAL" TO WS-REASON-CODE
    ELSE
        MOVE "INCONSISTENT" TO WS-OUTPUT-CODE
        IF WS-DELTA > 0
            MOVE "ACTUAL_BELOW_EXPECTED" TO WS-REASON-CODE
        ELSE
            MOVE "ACTUAL_ABOVE_EXPECTED" TO WS-REASON-CODE
        END-IF
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_GUARD_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM COMPARE-VALUES
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
