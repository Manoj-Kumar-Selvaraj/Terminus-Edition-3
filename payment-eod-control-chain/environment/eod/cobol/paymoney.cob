>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYMONEY.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-AMOUNT-TEXT                PIC X(24).
01 WS-FEE-TEXT                   PIC X(24).
01 WS-TAX-TEXT                   PIC X(24).
01 WS-AMOUNT                     PIC S9(15) VALUE 0.
01 WS-FEE                        PIC S9(15) VALUE 0.
01 WS-TAX                        PIC S9(15) VALUE 0.
01 WS-TOTAL-DEBIT                PIC S9(15) VALUE 0.
01 WS-CHARGE-TOTAL               PIC S9(15) VALUE 0.
01 WS-CHARGE-FLAG                PIC X VALUE "N".
   88 HAS-CHARGES                VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-AMOUNT-TEXT WS-FEE-TEXT WS-TAX-TEXT TALLYING IN WS-FIELD-COUNT END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION TRIM(WS-AMOUNT-TEXT) TO WS-AMOUNT-TEXT
    MOVE FUNCTION TRIM(WS-FEE-TEXT) TO WS-FEE-TEXT
    MOVE FUNCTION TRIM(WS-TAX-TEXT) TO WS-TAX-TEXT.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 3
        SET INPUT-INVALID TO TRUE
    END-IF
    IF INPUT-VALID
        COMPUTE WS-AMOUNT = FUNCTION NUMVAL(WS-AMOUNT-TEXT)
        COMPUTE WS-FEE = FUNCTION NUMVAL(WS-FEE-TEXT)
        COMPUTE WS-TAX = FUNCTION NUMVAL(WS-TAX-TEXT)
        IF WS-AMOUNT <= 0 OR WS-FEE < 0 OR WS-TAX < 0
            SET INPUT-INVALID TO TRUE
        END-IF
    END-IF.

CLASSIFY-CHARGES.
    COMPUTE WS-CHARGE-TOTAL = WS-FEE + WS-TAX
    IF WS-CHARGE-TOTAL > 0
        MOVE "Y" TO WS-CHARGE-FLAG
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
        MOVE "BAD_MONEY_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-CHARGES
        COMPUTE WS-TOTAL-DEBIT = WS-AMOUNT
        IF HAS-CHARGES
            MOVE "CHARGES_PRESENT" TO WS-REASON-CODE
        ELSE
            MOVE "NO_CHARGES" TO WS-REASON-CODE
        END-IF
        MOVE WS-TOTAL-DEBIT TO WS-OUTPUT-CODE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        DISPLAY "INVALID"
    ELSE
        DISPLAY WS-TOTAL-DEBIT
    END-IF.
