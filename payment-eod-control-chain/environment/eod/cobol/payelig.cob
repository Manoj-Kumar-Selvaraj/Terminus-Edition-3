>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYELIG.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-PAYER-STATUS               PIC X(16).
01 WS-BENEFICIARY-STATUS         PIC X(16).
01 WS-ROUTE-TYPE                 PIC X(16).
01 WS-PAYER-ACTIVE-FLAG          PIC X VALUE "N".
   88 PAYER-ACTIVE               VALUE "Y".
01 WS-BENEFICIARY-ACTIVE-FLAG    PIC X VALUE "N".
   88 BENEFICIARY-ACTIVE         VALUE "Y".
01 WS-INTERNAL-FLAG              PIC X VALUE "N".
   88 INTERNAL-ROUTE             VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|"
        INTO WS-PAYER-STATUS WS-BENEFICIARY-STATUS WS-ROUTE-TYPE
        TALLYING IN WS-FIELD-COUNT
    END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-PAYER-STATUS) TO WS-PAYER-STATUS
    MOVE FUNCTION UPPER-CASE(WS-BENEFICIARY-STATUS) TO WS-BENEFICIARY-STATUS
    MOVE FUNCTION UPPER-CASE(WS-ROUTE-TYPE) TO WS-ROUTE-TYPE.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 3
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-ROUTE-TYPE NOT = "INTERNAL" AND WS-ROUTE-TYPE NOT = "EXTERNAL"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-PAYER-STATUS = SPACES
        SET INPUT-INVALID TO TRUE
    END-IF.

CLASSIFY-PARTICIPANTS.
    IF WS-PAYER-STATUS = "ACTIVE"
        MOVE "Y" TO WS-PAYER-ACTIVE-FLAG
    END-IF
    IF WS-BENEFICIARY-STATUS = "ACTIVE"
        MOVE "Y" TO WS-BENEFICIARY-ACTIVE-FLAG
    END-IF
    IF WS-ROUTE-TYPE = "INTERNAL"
        MOVE "Y" TO WS-INTERNAL-FLAG
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_ELIGIBILITY_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-PARTICIPANTS
        EVALUATE TRUE
            WHEN WS-PAYER-STATUS NOT = "ACTIVE"
                MOVE "REJECT_PAYER" TO WS-OUTPUT-CODE
                MOVE "PAYER_NOT_ACTIVE" TO WS-REASON-CODE
            WHEN INTERNAL-ROUTE
                MOVE "ELIGIBLE" TO WS-OUTPUT-CODE
                MOVE "INTERNAL_PARTICIPANTS_ACCEPTED" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "ELIGIBLE" TO WS-OUTPUT-CODE
                MOVE "EXTERNAL_ROUTE_ACCEPTED" TO WS-REASON-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
