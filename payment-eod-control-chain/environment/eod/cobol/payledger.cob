>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYLEDGER.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-DEBIT-TEXT                 PIC X(24).
01 WS-CREDIT-TEXT                PIC X(24).
01 WS-EXPECTED-ROWS-TEXT         PIC X(12).
01 WS-ACTUAL-ROWS-TEXT           PIC X(12).
01 WS-DEBIT                      PIC S9(15) VALUE 0.
01 WS-CREDIT                     PIC S9(15) VALUE 0.
01 WS-EXPECTED-ROWS              PIC 9(9) VALUE 0.
01 WS-ACTUAL-ROWS                PIC 9(9) VALUE 0.
01 WS-DIFFERENCE                 PIC S9(15) VALUE 0.
01 WS-BALANCED-FLAG              PIC X VALUE "N".
   88 LEDGER-BALANCED            VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|"
        INTO WS-DEBIT-TEXT WS-CREDIT-TEXT WS-EXPECTED-ROWS-TEXT WS-ACTUAL-ROWS-TEXT
        TALLYING IN WS-FIELD-COUNT
    END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION TRIM(WS-DEBIT-TEXT) TO WS-DEBIT-TEXT
    MOVE FUNCTION TRIM(WS-CREDIT-TEXT) TO WS-CREDIT-TEXT
    MOVE FUNCTION TRIM(WS-EXPECTED-ROWS-TEXT) TO WS-EXPECTED-ROWS-TEXT
    MOVE FUNCTION TRIM(WS-ACTUAL-ROWS-TEXT) TO WS-ACTUAL-ROWS-TEXT.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 4
        SET INPUT-INVALID TO TRUE
    END-IF
    IF INPUT-VALID
        COMPUTE WS-DEBIT = FUNCTION NUMVAL(WS-DEBIT-TEXT)
        COMPUTE WS-CREDIT = FUNCTION NUMVAL(WS-CREDIT-TEXT)
        COMPUTE WS-EXPECTED-ROWS = FUNCTION NUMVAL(WS-EXPECTED-ROWS-TEXT)
        COMPUTE WS-ACTUAL-ROWS = FUNCTION NUMVAL(WS-ACTUAL-ROWS-TEXT)
        IF WS-DEBIT < 0 OR WS-CREDIT < 0
            SET INPUT-INVALID TO TRUE
        END-IF
        IF WS-EXPECTED-ROWS <= 0 OR WS-ACTUAL-ROWS < 0
            SET INPUT-INVALID TO TRUE
        END-IF
    END-IF.

CLASSIFY-LEDGER.
    COMPUTE WS-DIFFERENCE = WS-DEBIT - WS-CREDIT
    IF WS-DEBIT >= WS-CREDIT
        MOVE "Y" TO WS-BALANCED-FLAG
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_LEDGER_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-LEDGER
        EVALUATE TRUE
            WHEN WS-BALANCED-FLAG NOT = "Y"
                MOVE "LEDGER_UNBALANCED" TO WS-OUTPUT-CODE
                MOVE "CREDIT_EXCEEDS_DEBIT" TO WS-REASON-CODE
            WHEN LEDGER-BALANCED
                MOVE "LEDGER_OK" TO WS-OUTPUT-CODE
                MOVE "LEDGER_TOTALS_ACCEPTED" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "INVALID" TO WS-OUTPUT-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
