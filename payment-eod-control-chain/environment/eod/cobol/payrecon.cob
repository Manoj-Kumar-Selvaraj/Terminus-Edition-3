>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYRECON.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 INPUT-LINE PIC X(1024).
01 D-TEXT PIC X(24).
01 C-TEXT PIC X(24).
01 D PIC 9(14).
01 C PIC 9(14).
PROCEDURE DIVISION.
MAIN.
    ACCEPT INPUT-LINE
    UNSTRING INPUT-LINE DELIMITED BY "|"
        INTO D-TEXT D-TEXT D-TEXT D-TEXT D-TEXT D-TEXT
             D-TEXT D-TEXT D-TEXT D-TEXT D-TEXT D-TEXT
             D-TEXT C-TEXT
    END-UNSTRING
    COMPUTE D = FUNCTION NUMVAL(D-TEXT)
    COMPUTE C = FUNCTION NUMVAL(C-TEXT)
    IF D = C
        DISPLAY "BALANCED"
    ELSE
        DISPLAY "HELD"
    END-IF
    STOP RUN.
