>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYRECON.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE PIC X(1024).
01 WS-FIELD-COUNT PIC 99 VALUE 0.
01 WS-VALID-FLAG PIC X VALUE "Y".
   88 INPUT-VALID VALUE "Y".
   88 INPUT-INVALID VALUE "N".
01 WS-OUTPUT-CODE PIC X(40) VALUE SPACES.
01 WS-REASON-CODE PIC X(48) VALUE SPACES.
01 WS-ORIGINAL-COUNT-TEXT PIC X(18).
01 WS-OUTCOME-COUNT-TEXT PIC X(18).
01 WS-ORIGINAL-VALUE-TEXT PIC X(24).
01 WS-RESPONSE-VALUE-TEXT PIC X(24).
01 WS-INT-SUCCESS-TEXT PIC X(18).
01 WS-INT-POST-TEXT PIC X(18).
01 WS-EXT-SUCCESS-TEXT PIC X(18).
01 WS-RESERVATION-TEXT PIC X(18).
01 WS-CLEARING-TEXT PIC X(18).
01 WS-RESERVED-DEBIT-TEXT PIC X(24).
01 WS-CLEARING-VALUE-TEXT PIC X(24).
01 WS-EXT-FEE-TAX-TEXT PIC X(24).
01 WS-LEDGER-DEBITS-TEXT PIC X(24).
01 WS-LEDGER-CREDITS-TEXT PIC X(24).
01 WS-INVALID-EFFECT-TEXT PIC X(18).
01 WS-MISMATCH-TEXT PIC X(18).
01 WS-MISSING-LEDGER-TEXT PIC X(18).
01 WS-ORIGINAL-COUNT PIC 9(9) VALUE 0.
01 WS-OUTCOME-COUNT PIC 9(9) VALUE 0.
01 WS-ORIGINAL-VALUE PIC S9(15) VALUE 0.
01 WS-RESPONSE-VALUE PIC S9(15) VALUE 0.
01 WS-INT-SUCCESS PIC 9(9) VALUE 0.
01 WS-INT-POST PIC 9(9) VALUE 0.
01 WS-EXT-SUCCESS PIC 9(9) VALUE 0.
01 WS-RESERVATION-COUNT PIC 9(9) VALUE 0.
01 WS-CLEARING-COUNT PIC 9(9) VALUE 0.
01 WS-RESERVED-DEBIT PIC S9(15) VALUE 0.
01 WS-CLEARING-VALUE PIC S9(15) VALUE 0.
01 WS-EXT-FEE-TAX PIC S9(15) VALUE 0.
01 WS-LEDGER-DEBITS PIC S9(15) VALUE 0.
01 WS-LEDGER-CREDITS PIC S9(15) VALUE 0.
01 WS-INVALID-EFFECT PIC 9(9) VALUE 0.
01 WS-MISMATCH-COUNT PIC 9(9) VALUE 0.
01 WS-MISSING-LEDGER PIC 9(9) VALUE 0.
01 WS-CONTROL-FAILURES PIC 99 VALUE 0.

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.
INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.
PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-ORIGINAL-COUNT-TEXT WS-OUTCOME-COUNT-TEXT WS-ORIGINAL-VALUE-TEXT WS-RESPONSE-VALUE-TEXT WS-INT-SUCCESS-TEXT WS-INT-POST-TEXT WS-EXT-SUCCESS-TEXT WS-RESERVATION-TEXT WS-CLEARING-TEXT WS-RESERVED-DEBIT-TEXT WS-CLEARING-VALUE-TEXT WS-EXT-FEE-TAX-TEXT WS-LEDGER-DEBITS-TEXT WS-LEDGER-CREDITS-TEXT WS-INVALID-EFFECT-TEXT WS-MISMATCH-TEXT WS-MISSING-LEDGER-TEXT TALLYING IN WS-FIELD-COUNT END-UNSTRING.
NORMALIZE-INPUT.
    CONTINUE.
VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 17
        SET INPUT-INVALID TO TRUE
    END-IF
    IF INPUT-VALID
        PERFORM CONVERT-METRICS
    END-IF.
CONVERT-METRICS.
    COMPUTE WS-ORIGINAL-COUNT = FUNCTION NUMVAL(WS-ORIGINAL-COUNT-TEXT)
    COMPUTE WS-OUTCOME-COUNT = FUNCTION NUMVAL(WS-OUTCOME-COUNT-TEXT)
    COMPUTE WS-ORIGINAL-VALUE = FUNCTION NUMVAL(WS-ORIGINAL-VALUE-TEXT)
    COMPUTE WS-RESPONSE-VALUE = FUNCTION NUMVAL(WS-RESPONSE-VALUE-TEXT)
    COMPUTE WS-INT-SUCCESS = FUNCTION NUMVAL(WS-INT-SUCCESS-TEXT)
    COMPUTE WS-INT-POST = FUNCTION NUMVAL(WS-INT-POST-TEXT)
    COMPUTE WS-EXT-SUCCESS = FUNCTION NUMVAL(WS-EXT-SUCCESS-TEXT)
    COMPUTE WS-RESERVATION-COUNT = FUNCTION NUMVAL(WS-RESERVATION-TEXT)
    COMPUTE WS-CLEARING-COUNT = FUNCTION NUMVAL(WS-CLEARING-TEXT)
    COMPUTE WS-RESERVED-DEBIT = FUNCTION NUMVAL(WS-RESERVED-DEBIT-TEXT)
    COMPUTE WS-CLEARING-VALUE = FUNCTION NUMVAL(WS-CLEARING-VALUE-TEXT)
    COMPUTE WS-EXT-FEE-TAX = FUNCTION NUMVAL(WS-EXT-FEE-TAX-TEXT)
    COMPUTE WS-LEDGER-DEBITS = FUNCTION NUMVAL(WS-LEDGER-DEBITS-TEXT)
    COMPUTE WS-LEDGER-CREDITS = FUNCTION NUMVAL(WS-LEDGER-CREDITS-TEXT)
    COMPUTE WS-INVALID-EFFECT = FUNCTION NUMVAL(WS-INVALID-EFFECT-TEXT)
    COMPUTE WS-MISMATCH-COUNT = FUNCTION NUMVAL(WS-MISMATCH-TEXT)
    COMPUTE WS-MISSING-LEDGER = FUNCTION NUMVAL(WS-MISSING-LEDGER-TEXT).
CHECK-CORE-CONTROLS.
    MOVE 0 TO WS-CONTROL-FAILURES
    IF WS-LEDGER-DEBITS NOT = WS-LEDGER-CREDITS
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF
    IF WS-ORIGINAL-COUNT NOT = WS-OUTCOME-COUNT
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF
    IF WS-ORIGINAL-VALUE NOT = WS-RESPONSE-VALUE
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF.
CHECK-FINANCIAL-SHAPE.
    IF WS-INT-SUCCESS NOT = WS-INT-POST
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF
    IF WS-EXT-SUCCESS NOT = WS-RESERVATION-COUNT
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF
    IF WS-EXT-SUCCESS NOT = WS-CLEARING-COUNT
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF
    IF WS-RESERVED-DEBIT NOT = WS-CLEARING-VALUE + WS-EXT-FEE-TAX
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF.
CHECK-EXCEPTION-CONTROLS.
    IF WS-INVALID-EFFECT NOT = 0
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF
    IF WS-MISMATCH-COUNT NOT = 0
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF
    IF WS-MISSING-LEDGER NOT = 0
        ADD 1 TO WS-CONTROL-FAILURES
    END-IF.
DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_RECON_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CHECK-CORE-CONTROLS
        IF WS-CONTROL-FAILURES = 0
            MOVE "BALANCED" TO WS-OUTPUT-CODE
            MOVE "CORE_CONTROLS_BALANCED" TO WS-REASON-CODE
        ELSE
            MOVE "HELD" TO WS-OUTPUT-CODE
            MOVE "CORE_CONTROL_FAILURE" TO WS-REASON-CODE
        END-IF
    END-IF.
EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
