>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYHIST.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-OUTCOME-CODE               PIC X(32).
01 WS-CURRENT-HISTORY            PIC X(16).
01 WS-CURRENT-ACCEPTED-FLAG      PIC X VALUE "N".
   88 CURRENT-ACCEPTED           VALUE "Y".
01 WS-SUCCESS-FLAG               PIC X VALUE "N".
   88 SUCCESS-OUTCOME            VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-OUTCOME-CODE WS-CURRENT-HISTORY TALLYING IN WS-FIELD-COUNT END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-OUTCOME-CODE) TO WS-OUTCOME-CODE
    MOVE FUNCTION UPPER-CASE(WS-CURRENT-HISTORY) TO WS-CURRENT-HISTORY.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 2
        SET INPUT-INVALID TO TRUE
    END-IF
    EVALUATE WS-OUTCOME-CODE
        WHEN "SUCCESS_INTERNAL"
        WHEN "SUCCESS_EXTERNAL"
        WHEN "REJECTED"
        WHEN "DUPLICATE"
            CONTINUE
        WHEN OTHER
            SET INPUT-INVALID TO TRUE
    END-EVALUATE.

CLASSIFY-HISTORY.
    IF WS-CURRENT-HISTORY = "ACCEPTED" OR WS-CURRENT-HISTORY = "COMPLETED"
        MOVE "Y" TO WS-CURRENT-ACCEPTED-FLAG
    END-IF
    IF WS-OUTCOME-CODE = "SUCCESS_INTERNAL" OR WS-OUTCOME-CODE = "SUCCESS_EXTERNAL"
        MOVE "Y" TO WS-SUCCESS-FLAG
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "UNKNOWN" TO WS-OUTPUT-CODE
        MOVE "BAD_HISTORY_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-HISTORY
        EVALUATE TRUE
            WHEN SUCCESS-OUTCOME
                MOVE "ACCEPTED" TO WS-OUTPUT-CODE
                MOVE "SUCCESS_ACCEPTED" TO WS-REASON-CODE
            WHEN WS-OUTCOME-CODE = "REJECTED"
                MOVE "REJECTED" TO WS-OUTPUT-CODE
                MOVE "BUSINESS_REJECTED" TO WS-REASON-CODE
            WHEN WS-OUTCOME-CODE = "DUPLICATE" AND CURRENT-ACCEPTED
                MOVE WS-CURRENT-HISTORY TO WS-OUTPUT-CODE
                MOVE "PRESERVE_PRIOR_ACCEPTANCE" TO WS-REASON-CODE
            WHEN WS-OUTCOME-CODE = "DUPLICATE"
                MOVE WS-CURRENT-HISTORY TO WS-OUTPUT-CODE
                MOVE "PRESERVE_HISTORY" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "UNKNOWN" TO WS-OUTPUT-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
