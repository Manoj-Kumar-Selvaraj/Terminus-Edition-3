>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYEXEC.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT IN-FILE ASSIGN TO "/app/eod/work/exec_input.psv"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT OUT-FILE ASSIGN TO "/app/eod/work/exec_output.psv"
        ORGANIZATION IS LINE SEQUENTIAL.
DATA DIVISION.
FILE SECTION.
FD IN-FILE.
01 IN-LINE PIC X(512).
FD OUT-FILE.
01 OUT-LINE PIC X(512).
WORKING-STORAGE SECTION.
01 EOF-IN PIC X VALUE 'N'.
01 P-ID PIC X(20).
01 P-ROUTE PIC X.
01 P-PAYER-STATUS PIC X(16).
01 P-BEN-STATUS PIC X(16).
01 P-AVAILABLE PIC 9(12).
01 P-AMOUNT PIC 9(12).
01 P-FEE PIC 9(12).
01 P-TAX PIC 9(12).
01 P-EXISTING PIC X(16).
01 P-TOTAL PIC 9(12).
01 P-ACTION PIC X(24).
01 P-REASON PIC X(40).
PROCEDURE DIVISION.
    OPEN INPUT IN-FILE OUTPUT OUT-FILE
    PERFORM UNTIL EOF-IN = 'Y'
        READ IN-FILE
            AT END MOVE 'Y' TO EOF-IN
            NOT AT END
                UNSTRING IN-LINE DELIMITED BY '|'
                  INTO P-ID P-ROUTE P-PAYER-STATUS P-BEN-STATUS P-AVAILABLE
                       P-AMOUNT P-FEE P-TAX P-EXISTING
                END-UNSTRING
                COMPUTE P-TOTAL = P-AMOUNT + P-FEE + P-TAX
                EVALUATE TRUE
                    WHEN P-EXISTING = 'INTERNAL'
                        MOVE 'ALREADY_INTERNAL' TO P-ACTION
                        MOVE 'RESUME' TO P-REASON
                    WHEN P-EXISTING = 'EXTERNAL'
                        MOVE 'ALREADY_EXTERNAL' TO P-ACTION
                        MOVE 'RESUME' TO P-REASON
                    WHEN P-PAYER-STATUS NOT = 'ACTIVE'
                        MOVE 'REJECT' TO P-ACTION
                        MOVE 'PAYER_INELIGIBLE' TO P-REASON
                    WHEN P-ROUTE = 'I' AND P-BEN-STATUS NOT = 'ACTIVE'
                        MOVE 'REJECT' TO P-ACTION
                        MOVE 'BENEFICIARY_INELIGIBLE' TO P-REASON
                    WHEN P-AVAILABLE < P-TOTAL
                        MOVE 'REJECT' TO P-ACTION
                        MOVE 'INSUFFICIENT_CAPACITY' TO P-REASON
                    WHEN P-ROUTE = 'I'
                        MOVE 'POST_INTERNAL' TO P-ACTION
                        MOVE 'AUTHORIZED' TO P-REASON
                    WHEN OTHER
                        MOVE 'RESERVE_EXTERNAL' TO P-ACTION
                        MOVE 'AUTHORIZED' TO P-REASON
                END-EVALUATE
                STRING P-ID DELIMITED BY SPACE '|' DELIMITED BY SIZE
                       P-ACTION DELIMITED BY SPACE '|' DELIMITED BY SIZE
                       P-TOTAL DELIMITED BY SIZE '|' DELIMITED BY SIZE
                       P-AMOUNT DELIMITED BY SIZE '|' DELIMITED BY SIZE
                       P-FEE DELIMITED BY SIZE '|' DELIMITED BY SIZE
                       P-TAX DELIMITED BY SIZE '|' DELIMITED BY SIZE
                       P-REASON DELIMITED BY SPACE
                  INTO OUT-LINE
                END-STRING
                WRITE OUT-LINE
        END-READ
    END-PERFORM
    CLOSE IN-FILE OUT-FILE
    STOP RUN.
