>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYCLOSE.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-RECON-STATUS               PIC X(16).
01 WS-DELIVERY-ACK               PIC X.
01 WS-REPORT-COMPLETE            PIC X.
01 WS-ARCHIVE-COMPLETE           PIC X.
01 WS-READY-COUNT                PIC 9 VALUE 0.
01 WS-RECON-READY-FLAG           PIC X VALUE "N".
   88 RECON-READY                VALUE "Y".
01 WS-DELIVERY-READY-FLAG        PIC X VALUE "N".
   88 DELIVERY-READY             VALUE "Y".
01 WS-REPORT-READY-FLAG          PIC X VALUE "N".
   88 REPORT-READY               VALUE "Y".
01 WS-ARCHIVE-READY-FLAG         PIC X VALUE "N".
   88 ARCHIVE-READY              VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|"
        INTO WS-RECON-STATUS WS-DELIVERY-ACK
             WS-REPORT-COMPLETE WS-ARCHIVE-COMPLETE
        TALLYING IN WS-FIELD-COUNT
    END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-RECON-STATUS) TO WS-RECON-STATUS
    MOVE FUNCTION UPPER-CASE(WS-DELIVERY-ACK) TO WS-DELIVERY-ACK
    MOVE FUNCTION UPPER-CASE(WS-REPORT-COMPLETE) TO WS-REPORT-COMPLETE
    MOVE FUNCTION UPPER-CASE(WS-ARCHIVE-COMPLETE) TO WS-ARCHIVE-COMPLETE.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 4
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-DELIVERY-ACK NOT = "0" AND WS-DELIVERY-ACK NOT = "1"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-REPORT-COMPLETE NOT = "0" AND WS-REPORT-COMPLETE NOT = "1"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-ARCHIVE-COMPLETE NOT = "0" AND WS-ARCHIVE-COMPLETE NOT = "1"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-RECON-STATUS NOT = "BALANCED"
       AND WS-RECON-STATUS NOT = "HELD"
       AND WS-RECON-STATUS NOT = "PENDING"
        SET INPUT-INVALID TO TRUE
    END-IF.

COUNT-READY-CONTROLS.
    MOVE 0 TO WS-READY-COUNT
    IF WS-RECON-STATUS = "BALANCED"
        MOVE "Y" TO WS-RECON-READY-FLAG
        ADD 1 TO WS-READY-COUNT
    END-IF
    IF WS-DELIVERY-ACK = "1"
        MOVE "Y" TO WS-DELIVERY-READY-FLAG
        ADD 1 TO WS-READY-COUNT
    END-IF
    IF WS-REPORT-COMPLETE = "1"
        MOVE "Y" TO WS-REPORT-READY-FLAG
        ADD 1 TO WS-READY-COUNT
    END-IF
    IF WS-ARCHIVE-COMPLETE = "1"
        MOVE "Y" TO WS-ARCHIVE-READY-FLAG
        ADD 1 TO WS-READY-COUNT
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_CLOSE_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM COUNT-READY-CONTROLS
        EVALUATE TRUE
            WHEN WS-RECON-STATUS = "HELD"
                MOVE "HOLD" TO WS-OUTPUT-CODE
                MOVE "RECONCILIATION_HELD" TO WS-REASON-CODE
            WHEN WS-RECON-STATUS NOT = "BALANCED"
                MOVE "WAIT_CLOSE" TO WS-OUTPUT-CODE
                MOVE "RECONCILIATION_NOT_READY" TO WS-REASON-CODE
            WHEN RECON-READY AND DELIVERY-READY
                MOVE "COMPLETE" TO WS-OUTPUT-CODE
                MOVE "CLOSE_CONTROLS_READY" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "WAIT_CLOSE" TO WS-OUTPUT-CODE
                MOVE "CLOSE_CONTROL_PENDING" TO WS-REASON-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
