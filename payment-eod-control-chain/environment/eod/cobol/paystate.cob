>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYSTATE.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE PIC X(1024).
01 WS-FIELD-COUNT PIC 99 VALUE 0.
01 WS-VALID-FLAG PIC X VALUE "Y".
   88 INPUT-VALID VALUE "Y".
   88 INPUT-INVALID VALUE "N".
01 WS-OUTPUT-CODE PIC X(40) VALUE SPACES.
01 WS-REASON-CODE PIC X(48) VALUE SPACES.
01 WS-CURRENT-STATE PIC X(24).
01 WS-RECON-STATUS PIC X(16).
01 WS-CLOSE-DECISION PIC X(24).
01 WS-RECON-FLAG PIC X VALUE "N".
   88 RECON-BALANCED VALUE "Y".
01 WS-CLOSE-FLAG PIC X VALUE "N".
   88 CLOSE-COMPLETE VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.
INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.
PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-CURRENT-STATE WS-RECON-STATUS WS-CLOSE-DECISION TALLYING IN WS-FIELD-COUNT END-UNSTRING.
NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-CURRENT-STATE) TO WS-CURRENT-STATE
    MOVE FUNCTION UPPER-CASE(WS-RECON-STATUS) TO WS-RECON-STATUS
    MOVE FUNCTION UPPER-CASE(WS-CLOSE-DECISION) TO WS-CLOSE-DECISION.
VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 3
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-RECON-STATUS NOT = "BALANCED" AND WS-RECON-STATUS NOT = "HELD" AND WS-RECON-STATUS NOT = "PENDING"
        SET INPUT-INVALID TO TRUE
    END-IF.
CLASSIFY-CONTROL-STATE.
    IF WS-RECON-STATUS = "BALANCED"
        MOVE "Y" TO WS-RECON-FLAG
    END-IF
    IF WS-CLOSE-DECISION = "COMPLETE"
        MOVE "Y" TO WS-CLOSE-FLAG
    END-IF.
DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_STATE_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-CONTROL-STATE
        EVALUATE TRUE
            WHEN WS-RECON-STATUS = "HELD"
                MOVE "HELD" TO WS-OUTPUT-CODE
                MOVE "RECONCILIATION_HELD" TO WS-REASON-CODE
            WHEN RECON-BALANCED
                MOVE "COMPLETED" TO WS-OUTPUT-CODE
                MOVE "BALANCED_STATE" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "PROCESSING" TO WS-OUTPUT-CODE
                MOVE "CONTROL_IN_PROGRESS" TO WS-REASON-CODE
        END-EVALUATE
    END-IF.
EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
