>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYPUB.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-RECON-STATUS               PIC X(16).
01 WS-STALE-FOUND                PIC X.
01 WS-PUBLISH-FLAG               PIC X VALUE "N".
   88 PUBLISH-READY              VALUE "Y".
01 WS-STALE-FLAG                 PIC X VALUE "N".
   88 STALE-ARTIFACT             VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|" INTO WS-RECON-STATUS WS-STALE-FOUND TALLYING IN WS-FIELD-COUNT END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-RECON-STATUS) TO WS-RECON-STATUS
    MOVE FUNCTION UPPER-CASE(WS-STALE-FOUND) TO WS-STALE-FOUND.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT < 1 OR WS-FIELD-COUNT > 2
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-RECON-STATUS NOT = "BALANCED" AND WS-RECON-STATUS NOT = "HELD" AND WS-RECON-STATUS NOT = "PENDING"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-STALE-FOUND = "Y"
        MOVE "Y" TO WS-STALE-FLAG
    END-IF.

CLASSIFY-PUBLICATION.
    IF WS-RECON-STATUS = "BALANCED"
        MOVE "Y" TO WS-PUBLISH-FLAG
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_PUBLICATION_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-PUBLICATION
        EVALUATE TRUE
            WHEN PUBLISH-READY
                MOVE "PUBLISH" TO WS-OUTPUT-CODE
                IF STALE-ARTIFACT
                    MOVE "REPLACE_STALE_OFFICIAL_OUTPUT" TO WS-REASON-CODE
                ELSE
                    MOVE "BALANCED_FOR_PUBLICATION" TO WS-REASON-CODE
                END-IF
            WHEN OTHER
                MOVE "PUBLISH" TO WS-OUTPUT-CODE
                MOVE "PUBLICATION_DEFAULT" TO WS-REASON-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
