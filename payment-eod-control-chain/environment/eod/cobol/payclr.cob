>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. PAYCLR.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INPUT-LINE                 PIC X(1024).
01 WS-FIELD-COUNT                PIC 99 VALUE 0.
01 WS-VALID-FLAG                 PIC X VALUE "Y".
   88 INPUT-VALID                VALUE "Y".
   88 INPUT-INVALID              VALUE "N".
01 WS-OUTPUT-CODE                PIC X(40) VALUE SPACES.
01 WS-REASON-CODE                PIC X(48) VALUE SPACES.
01 WS-RESERVATION-PRESENT        PIC X.
01 WS-CLEARING-PRESENT           PIC X.
01 WS-RESERVATION-MATCH          PIC X.
01 WS-STATE-SCORE                PIC 9 VALUE 0.
01 WS-RESERVATION-FLAG           PIC X VALUE "N".
   88 RESERVATION-PRESENT        VALUE "Y".
01 WS-CLEARING-FLAG              PIC X VALUE "N".
   88 CLEARING-PRESENT           VALUE "Y".
01 WS-MATCH-FLAG                 PIC X VALUE "N".
   88 RESERVATION-MATCH          VALUE "Y".

PROCEDURE DIVISION.
MAIN.
    PERFORM INITIALIZE-STATE
    ACCEPT WS-INPUT-LINE
    PERFORM PARSE-INPUT
    PERFORM NORMALIZE-INPUT
    PERFORM VALIDATE-INPUT
    PERFORM DECIDE-RESULT
    PERFORM EMIT-RESULT
    STOP RUN.

INITIALIZE-STATE.
    MOVE 0 TO WS-FIELD-COUNT
    SET INPUT-VALID TO TRUE
    MOVE SPACES TO WS-OUTPUT-CODE WS-REASON-CODE.

PARSE-INPUT.
    UNSTRING WS-INPUT-LINE DELIMITED BY "|"
        INTO WS-RESERVATION-PRESENT WS-CLEARING-PRESENT WS-RESERVATION-MATCH
        TALLYING IN WS-FIELD-COUNT
    END-UNSTRING.

NORMALIZE-INPUT.
    MOVE FUNCTION UPPER-CASE(WS-RESERVATION-PRESENT) TO WS-RESERVATION-PRESENT
    MOVE FUNCTION UPPER-CASE(WS-CLEARING-PRESENT) TO WS-CLEARING-PRESENT
    MOVE FUNCTION UPPER-CASE(WS-RESERVATION-MATCH) TO WS-RESERVATION-MATCH.

VALIDATE-INPUT.
    IF WS-FIELD-COUNT NOT = 3
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-RESERVATION-PRESENT NOT = "Y" AND WS-RESERVATION-PRESENT NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-CLEARING-PRESENT NOT = "Y" AND WS-CLEARING-PRESENT NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF
    IF WS-RESERVATION-MATCH NOT = "Y" AND WS-RESERVATION-MATCH NOT = "N"
        SET INPUT-INVALID TO TRUE
    END-IF.

CLASSIFY-STATE.
    MOVE 0 TO WS-STATE-SCORE
    IF WS-RESERVATION-PRESENT = "Y"
        MOVE "Y" TO WS-RESERVATION-FLAG
        ADD 4 TO WS-STATE-SCORE
    END-IF
    IF WS-CLEARING-PRESENT = "Y"
        MOVE "Y" TO WS-CLEARING-FLAG
        ADD 2 TO WS-STATE-SCORE
    END-IF
    IF WS-RESERVATION-MATCH = "Y"
        MOVE "Y" TO WS-MATCH-FLAG
        ADD 1 TO WS-STATE-SCORE
    END-IF.

DECIDE-RESULT.
    IF INPUT-INVALID
        MOVE "BAD_CLEARING_INPUT" TO WS-REASON-CODE
    ELSE
        PERFORM CLASSIFY-STATE
        EVALUATE TRUE
            WHEN WS-RESERVATION-PRESENT = "N"
                MOVE "HOLD_NO_RESERVATION" TO WS-OUTPUT-CODE
                MOVE "RESERVATION_NOT_DURABLE" TO WS-REASON-CODE
            WHEN CLEARING-PRESENT
                MOVE "CREATE_CLEARING" TO WS-OUTPUT-CODE
                MOVE "RECREATE_EXISTING_CLEARING" TO WS-REASON-CODE
            WHEN RESERVATION-PRESENT
                MOVE "CREATE_CLEARING" TO WS-OUTPUT-CODE
                MOVE "CLEARING_MISSING" TO WS-REASON-CODE
            WHEN OTHER
                MOVE "INVALID" TO WS-OUTPUT-CODE
                MOVE "UNCLASSIFIED_STATE" TO WS-REASON-CODE
        END-EVALUATE
    END-IF.

EMIT-RESULT.
    IF INPUT-INVALID
        MOVE "INVALID" TO WS-OUTPUT-CODE
    END-IF
    DISPLAY FUNCTION TRIM(WS-OUTPUT-CODE).
