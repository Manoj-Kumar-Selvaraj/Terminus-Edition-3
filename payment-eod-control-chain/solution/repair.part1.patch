+    IF FIELD-COUNT < 3
+        MOVE "N" TO VALID-INPUT
     END-IF
-    DISPLAY FUNCTION TRIM(OUTPUT-CODE)
-    STOP RUN.
+    IF ROUTE-TYPE NOT = "INTERNAL" AND ROUTE-TYPE NOT = "EXTERNAL"
+        MOVE "N" TO VALID-INPUT
